<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Struk - <%= sale.invoice_number %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Courier New', monospace; font-size: 12px; width: 300px; margin: 0 auto; padding: 10px; }
    .receipt-header { text-align: center; margin-bottom: 10px; border-bottom: 1px dashed #000; padding-bottom: 8px; }
    .receipt-header h1 { font-size: 16px; }
    .receipt-header p { font-size: 10px; }
    .receipt-info { margin-bottom: 8px; font-size: 11px; }
    .receipt-info div { display: flex; justify-content: space-between; }
    .receipt-items { border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 8px 0; margin-bottom: 8px; }
    .receipt-items .item { margin-bottom: 4px; }
    .receipt-items .item-name { font-weight: bold; }
    .receipt-items .item-detail { display: flex; justify-content: space-between; padding-left: 10px; }
    .receipt-totals { margin-bottom: 8px; }
    .receipt-totals div { display: flex; justify-content: space-between; }
    .receipt-totals .grand-total { font-weight: bold; font-size: 14px; border-top: 1px dashed #000; padding-top: 4px; margin-top: 4px; }
    .receipt-footer { text-align: center; border-top: 1px dashed #000; padding-top: 8px; font-size: 10px; }
    .no-print { margin-top: 20px; text-align: center; }
    @media print { .no-print { display: none; } body { width: 100%; } }
  </style>
</head>
<body>
  <div class="receipt-header">
    <h1><%= typeof settings !== 'undefined' && settings.store_name ? settings.store_name : 'MINIMARKET' %></h1>
    <% if (typeof settings !== 'undefined' && settings.store_address) { %>
      <p><%= settings.store_address %></p>
    <% } %>
    <% if (typeof settings !== 'undefined' && settings.store_phone) { %>
      <p>Telp: <%= settings.store_phone %></p>
    <% } %>
  </div>

  <div class="receipt-info">
    <div><span>No:</span><span><%= sale.invoice_number %></span></div>
    <div><span>Tanggal:</span><span><%= new Date(sale.created_at).toLocaleString('id-ID') %></span></div>
    <div><span>Kasir:</span><span><%= sale.cashier_name %></span></div>
  </div>

  <div class="receipt-items">
    <% sale.items.forEach(item => { %>
    <div class="item">
      <div class="item-name"><%= item.product_name_snapshot %></div>
      <div class="item-detail">
        <span><%= item.quantity %> x Rp <%= new Intl.NumberFormat('id-ID').format(item.unit_price) %></span>
        <span>Rp <%= new Intl.NumberFormat('id-ID').format(item.subtotal) %></span>
      </div>
    </div>
    <% }); %>
  </div>

  <div class="receipt-totals">
    <div><span>Subtotal</span><span>Rp <%= new Intl.NumberFormat('id-ID').format(sale.subtotal) %></span></div>
    <% if (sale.discount > 0) { %>
    <div><span>Diskon</span><span>-Rp <%= new Intl.NumberFormat('id-ID').format(sale.discount) %></span></div>
    <% } %>
    <div class="grand-total"><span>TOTAL</span><span>Rp <%= new Intl.NumberFormat('id-ID').format(sale.total) %></span></div>
    <div><span>Bayar (<%= sale.payment_method %>)</span><span>Rp <%= new Intl.NumberFormat('id-ID').format(sale.paid_amount) %></span></div>
    <% if (sale.change_amount > 0) { %>
    <div><span>Kembali</span><span>Rp <%= new Intl.NumberFormat('id-ID').format(sale.change_amount) %></span></div>
    <% } %>
  </div>

  <div class="receipt-footer">
    <p><%= typeof settings !== 'undefined' && settings.receipt_footer ? settings.receipt_footer : 'Terima kasih atas kunjungan Anda!' %></p>
    <p>Barang yang sudah dibeli tidak dapat dikembalikan tanpa persetujuan</p>
  </div>

  <div class="no-print">
    <button onclick="window.print()" style="padding:8px 24px;font-size:14px;cursor:pointer">🖨 Cetak</button>
    <button onclick="window.close()" style="padding:8px 24px;font-size:14px;cursor:pointer;margin-left:8px">Tutup</button>
  </div>
</body>
</html>
