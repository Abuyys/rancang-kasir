<script src="/js/html5-qrcode.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  let cart = [];
  let selectedMethod = 'cash';
  let searchTimeout;

  const fmt = (n) => new Intl.NumberFormat('id-ID').format(Math.round(n));

  // DOM Elements
  const searchInput = document.getElementById('searchInput');
  const productGrid = document.getElementById('productGrid');
  const cartItemsEl = document.getElementById('cartItems');
  const cartEmpty = document.getElementById('cartEmpty');
  const cartCount = document.getElementById('cartCount');
  const cartSubtotal = document.getElementById('cartSubtotal');
  const discountInput = document.getElementById('discountInput');
  const cartTotal = document.getElementById('cartTotal');
  const payBtnSection = document.getElementById('payBtnSection');
  const payBtn = document.getElementById('payBtn');
  const paymentSection = document.getElementById('paymentSection');
  const paidAmountInput = document.getElementById('paidAmountInput');
  const changeDisplay = document.getElementById('changeDisplay');
  const changeAmount = document.getElementById('changeAmount');
  const checkoutBtn = document.getElementById('checkoutBtn');
  const cancelPayBtn = document.getElementById('cancelPayBtn');
  const clearCartBtn = document.getElementById('clearCartBtn');
  const posCartPanel = document.getElementById('posCartPanel');

  // Mobile navigation references
  const posContainer = document.getElementById('posContainer');
  const tabBtnProducts = document.getElementById('tabBtnProducts');
  const tabBtnCart = document.getElementById('tabBtnCart');
  const mCartBadge = document.getElementById('mCartBadge');
  const mCartSum = document.getElementById('mCartSum');
  const posFloatingCheckout = document.getElementById('posFloatingCheckout');
  const floatingItemCount = document.getElementById('floatingItemCount');
  const floatingTotal = document.getElementById('floatingTotal');
  const btnFloatingView = document.getElementById('btnFloatingView');
  const btnBackToProducts = document.getElementById('btnBackToProducts');

  function setMobileView(view) {
    if (!posContainer) return;
    posContainer.setAttribute('data-mobile-view', view);
    if (tabBtnProducts && tabBtnCart) {
      if (view === 'products') {
        tabBtnProducts.classList.add('active');
        tabBtnCart.classList.remove('active');
        if (btnBackToProducts) btnBackToProducts.style.display = 'none';
        updateFloatingBar();
      } else {
        tabBtnProducts.classList.remove('active');
        tabBtnCart.classList.add('active');
        if (btnBackToProducts) btnBackToProducts.style.display = 'inline-block';
        if (posFloatingCheckout) posFloatingCheckout.style.display = 'none';
      }
    }
  }

  function updateFloatingBar() {
    if (!posFloatingCheckout) return;
    const totalItems = cart.reduce((s, i) => s + i.quantity, 0);
    const isMobile = window.innerWidth <= 960;
    const currentView = posContainer ? posContainer.getAttribute('data-mobile-view') : 'products';
    
    if (isMobile && totalItems > 0 && currentView === 'products') {
      posFloatingCheckout.style.display = 'flex';
    } else {
      posFloatingCheckout.style.display = 'none';
    }
  }

  if (tabBtnProducts) {
    tabBtnProducts.addEventListener('click', () => setMobileView('products'));
  }
  if (tabBtnCart) {
    tabBtnCart.addEventListener('click', () => setMobileView('cart'));
  }
  if (btnFloatingView) {
    btnFloatingView.addEventListener('click', () => setMobileView('cart'));
  }
  if (btnBackToProducts) {
    btnBackToProducts.addEventListener('click', () => setMobileView('products'));
  }

  window.addEventListener('resize', () => {
    updateFloatingBar();
  });

  // Web Audio Synth feedback
  const audioCtx = window.AudioContext || window.webkitAudioContext ? new (window.AudioContext || window.webkitAudioContext)() : null;
  function playSuccessBeep() {
    if (!audioCtx) return;
    try {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1400, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.08);
    } catch (e) {}
  }

  function playErrorBuzz() {
    if (!audioCtx) return;
    try {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(250, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.25);
    } catch (e) {}
  }

  function showToast(msg, type = 'success') {
    const toast = document.getElementById('scanFeedbackToast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = `scan-feedback-toast toast-${type} show`;
    clearTimeout(toast._timeout);
    toast._timeout = setTimeout(() => {
      toast.classList.remove('show');
    }, 2200);
  }

  // === Product Search & Barcode Detection ===
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => searchProducts(searchInput.value.trim(), false), 250);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      searchProducts(searchInput.value.trim(), true);
    }
  });

  let isScanningBarcode = false;
  async function searchProducts(query, isScanner = false) {
    if (!query) {
      productGrid.innerHTML = `
        <div class="dash-empty-state" style="grid-column:1/-1;padding:3rem 1rem;text-align:center;color:#64748b">
          <div style="font-size:2.5rem;margin-bottom:0.5rem">🛒</div>
          <p style="font-weight:700;font-size:1rem;color:#334155;margin:0 0 0.25rem">Ketik nama produk atau scan barcode</p>
          <span style="font-size:0.85rem">Item akan otomatis masuk ke keranjang saat barcode terdeteksi.</span>
        </div>`;
      return;
    }

    if (isScanningBarcode) return;

    // Check if query looks like barcode or was explicitly submitted via Enter
    const looksLikeBarcode = /^\d{6,14}$/.test(query);

    if (isScanner || looksLikeBarcode) {
      isScanningBarcode = true;
      try {
        const res = await fetch(`/api/products/barcode/${encodeURIComponent(query)}`);
        const data = await res.json();
        if (res.ok && data.success && data.data) {
          addToCart(data.data);
          playSuccessBeep();
          if (navigator.vibrate) navigator.vibrate([70]);
          showToast(`✅ ${data.data.name} (+1)`, 'success');
          searchInput.value = '';
          searchInput.focus();
          isScanningBarcode = false;
          return;
        } else if (isScanner || looksLikeBarcode) {
          playErrorBuzz();
          showToast(`⚠️ ${data.message || 'Barcode tidak ditemukan atau produk nonaktif'}`, 'error');
          if (isScanner) {
            searchInput.select();
          }
        }
      } catch (e) {
        if (isScanner) {
          playErrorBuzz();
          showToast('⚠️ Gagal memindai barcode', 'error');
        }
      } finally {
        isScanningBarcode = false;
      }
    }

    // Fallback search by name or SKU
    try {
      const res = await fetch(`/api/products?search=${encodeURIComponent(query)}&status=active&limit=50`);
      const data = await res.json();
      if (data.success) {
        renderProducts(data.data.data);
      }
    } catch (e) {
      productGrid.innerHTML = '<p style="color:#dc2626;grid-column:1/-1;text-align:center;padding:2rem">Gagal memuat produk.</p>';
    }
  }

  // === Camera Scanner for POS ===
  const btnPosCam = document.getElementById('btnPosCam');
  const posCameraModal = document.getElementById('posCameraModal');
  const btnClosePosCam = document.getElementById('btnClosePosCam');
  const btnBottomClosePosCam = document.getElementById('btnBottomClosePosCam');
  const btnPosCamTorch = document.getElementById('btnPosCamTorch');
  const btnRetryCam = document.getElementById('btnRetryCam');
  const posCamStatus = document.getElementById('posCamStatus');
  const posCamSelectWrap = document.getElementById('posCamSelectWrap');
  const posCamSelect = document.getElementById('posCamSelect');
  let posHtml5QrCode = null;
  let posTorchOn = false;
  let lastScannedCode = null;
  let lastScannedTime = 0;
  let availableCameras = [];

  function closePosCamera() {
    // 1. Immediately hide UI first so user is never stuck
    if (posCameraModal) posCameraModal.style.display = 'none';
    if (btnPosCamTorch) btnPosCamTorch.style.display = 'none';
    if (btnRetryCam) btnRetryCam.style.display = 'none';
    if (posCamStatus) posCamStatus.textContent = '';
    posTorchOn = false;

    // 2. Safely stop and cleanup camera in background
    if (posHtml5QrCode) {
      const qr = posHtml5QrCode;
      posHtml5QrCode = null;
      try {
        if (typeof qr.isScanning === 'boolean' ? qr.isScanning : true) {
          qr.stop().catch(() => {}).finally(() => {
            try { qr.clear(); } catch (e) {}
          });
        } else {
          try { qr.clear(); } catch (e) {}
        }
      } catch (err) {}
    }

    if (searchInput) searchInput.focus();
  }

  if (btnPosCam) btnPosCam.addEventListener('click', openPosCamera);
  if (btnClosePosCam) btnClosePosCam.addEventListener('click', closePosCamera);
  if (btnBottomClosePosCam) btnBottomClosePosCam.addEventListener('click', closePosCamera);
  if (btnRetryCam) btnRetryCam.addEventListener('click', () => startCameraWithDetection());

  if (posCameraModal) {
    posCameraModal.addEventListener('click', (e) => {
      if (e.target === posCameraModal) closePosCamera();
    });
  }

  // Allow Esc key to close camera modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && posCameraModal && posCameraModal.style.display === 'flex') {
      closePosCamera();
    }
  });

  async function openPosCamera() {
    posCameraModal.style.display = 'flex';
    posCamStatus.style.color = '#64748b';
    posCamStatus.textContent = 'Memeriksa perangkat kamera...';
    btnRetryCam.style.display = 'none';
    lastScannedCode = null;
    lastScannedTime = 0;
    await startCameraWithDetection();
  }

  async function startCameraWithDetection(preferredDeviceId = null) {
    if (!window.Html5Qrcode) {
      posCamStatus.style.color = '#dc2626';
      posCamStatus.textContent = 'Pustaka pemindai barcode belum siap.';
      btnRetryCam.style.display = 'inline-block';
      return;
    }

    // Stop existing camera if running
    if (posHtml5QrCode) {
      try {
        await posHtml5QrCode.stop().catch(() => {});
        posHtml5QrCode.clear();
      } catch (e) {}
      posHtml5QrCode = null;
    }

    // Check secure context
    const isLocalhost = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    const isHttps = window.location.protocol === 'https:';
    if (!isLocalhost && !isHttps) {
      posCamStatus.style.color = '#dc2626';
      posCamStatus.innerHTML = '⚠️ <b>Kamera browser membutuhkan HTTPS atau localhost.</b><br>' +
        'Jika membuka dari HP melalui IP (' + window.location.host + '), browser memblokir kamera untuk privasi.<br>' +
        '<small style="color:#64748b">Solusi: Buka via <b>localhost:3000</b> di komputer ini, gunakan HTTPS, atau gunakan Scanner Barcode USB.</small>';
      btnRetryCam.style.display = 'none';
      return;
    }

    try {
      // Query available cameras
      try {
        availableCameras = await Html5Qrcode.getCameras();
      } catch (e) {
        availableCameras = [];
      }

      if (availableCameras && availableCameras.length > 0) {
        if (availableCameras.length > 1 && posCamSelectWrap) {
          posCamSelectWrap.style.display = 'block';
          posCamSelect.innerHTML = availableCameras.map((c, i) =>
            `<option value="${c.id}">${c.label || ('Kamera ' + (i + 1))}</option>`
          ).join('');
        } else if (posCamSelectWrap) {
          posCamSelectWrap.style.display = 'none';
        }

        let targetId = preferredDeviceId;
        if (!targetId) {
          const back = availableCameras.find(c => {
            const l = (c.label || '').toLowerCase();
            return l.includes('back') || l.includes('rear') || l.includes('belakang') || l.includes('environment');
          });
          targetId = back ? back.id : availableCameras[0].id;
        }

        if (posCamSelect) posCamSelect.value = targetId;
        await launchPosScanner(targetId);
      } else {
        // Fallback: try environment then user
        try {
          await launchPosScanner({ facingMode: "environment" });
        } catch (fErr) {
          await launchPosScanner({ facingMode: "user" });
        }
      }
    } catch (err) {
      console.warn('Camera error:', err);
      posCamStatus.style.color = '#dc2626';
      const msg = err.message || '';
      if (err.name === 'NotAllowedError' || msg.includes('Permission denied') || msg.includes('denied')) {
        posCamStatus.innerHTML = '🚫 <b>Izin kamera diblokir di browser.</b><br>' +
          'Klik ikon gembok/kamera di sebelah kiri URL browser, ubah Kamera menjadi <b>Allow</b> / Izinkan, lalu klik tombol <b>Coba Lagi</b> di bawah.';
      } else if (err.name === 'NotFoundError' || msg.includes('Requested device not found') || msg.includes('not found')) {
        posCamStatus.innerHTML = '📷 <b>Tidak ada kamera/webcam di komputer ini.</b><br>' +
          'Komputer desktop kasir dapat langsung menggunakan <b>Scanner Barcode USB</b> (colok & scan ke kolom pencarian).';
      } else {
        posCamStatus.innerHTML = '⚠️ <b>Akses kamera gagal:</b> ' + (msg || 'Kamera tidak tersedia atau sedang dipakai aplikasi lain.') + '<br>' +
          '<small style="color:#64748b">Silakan gunakan scanner barcode USB atau ketik nama/SKU produk.</small>';
      }
      btnRetryCam.style.display = 'inline-block';
    }
  }

  async function launchPosScanner(cameraSource) {
    posHtml5QrCode = new Html5Qrcode("posCamReader");
    const scanConfig = {
      fps: 15,
      qrbox: { width: 260, height: 160 },
      aspectRatio: 1.0,
      experimentalFeatures: {
        useBarCodeDetectorIfSupported: true
      }
    };

    await posHtml5QrCode.start(
      cameraSource,
      scanConfig,
      async (decodedText) => {
        const code = decodedText.trim();
        const now = Date.now();
        // 1.5s Anti-duplicate debounce
        if (code === lastScannedCode && (now - lastScannedTime) < 1500) {
          return;
        }
        lastScannedCode = code;
        lastScannedTime = now;

        // Fetch product
        try {
          const res = await fetch(`/api/products/barcode/${encodeURIComponent(code)}`);
          const data = await res.json();
          if (res.ok && data.success && data.data) {
            addToCart(data.data);
            playSuccessBeep();
            if (navigator.vibrate) navigator.vibrate([80]);
            posCamStatus.style.color = '#16a34a';
            posCamStatus.textContent = `✅ +1 ${data.data.name}`;
            showToast(`✅ ${data.data.name} (+1)`, 'success');
          } else {
            playErrorBuzz();
            posCamStatus.style.color = '#dc2626';
            posCamStatus.textContent = `⚠️ Barcode "${code}" tidak ditemukan`;
            showToast(`⚠️ Barcode ${code} tidak ditemukan`, 'error');
          }
        } catch (e) {
          playErrorBuzz();
          posCamStatus.style.color = '#dc2626';
          posCamStatus.textContent = 'Gagal memeriksa barcode';
        }
      },
      () => {}
    );

    posCamStatus.style.color = '#15803d';
    posCamStatus.textContent = 'Kamera aktif. Arahkan barcode ke kotak.';
    btnRetryCam.style.display = 'none';

    try {
      const capabilities = posHtml5QrCode.getRunningTrackCapabilities();
      if (capabilities && capabilities.torch) {
        btnPosCamTorch.style.display = 'inline-block';
      }
    } catch (e) {}
  }

  if (posCamSelect) {
    posCamSelect.addEventListener('change', () => {
      startCameraWithDetection(posCamSelect.value);
    });
  }

  if (btnPosCamTorch) {
    btnPosCamTorch.addEventListener('click', () => {
      if (posHtml5QrCode) {
        posTorchOn = !posTorchOn;
        posHtml5QrCode.applyVideoConstraints({
          advanced: [{ torch: posTorchOn }]
        }).catch(() => {});
      }
    });
  }

  // Keep autofocus on searchInput unless user is interacting with inputs/buttons
  document.addEventListener('click', (e) => {
    const tag = e.target.tagName.toLowerCase();
    const isInteractive = ['input', 'button', 'select', 'textarea', 'a'].includes(tag);
    const inModal = e.target.closest('#receiptModal') || e.target.closest('#posCameraModal');
    if (!isInteractive && !inModal && paymentSection && !paymentSection.classList.contains('active')) {
      searchInput.focus();
    }
  });

  function renderProducts(products) {
    if (!products || products.length === 0) {
      productGrid.innerHTML = `
        <div style="grid-column:1/-1;text-align:center;padding:3rem 1rem;color:#64748b">
          <div style="font-size:2rem;margin-bottom:0.35rem">🔍</div>
          <strong style="color:#1e293b">Produk tidak ditemukan</strong>
          <p style="font-size:0.85rem;margin:0.25rem 0 0">Pastikan ejaan benar atau daftarkan produk di menu Katalog.</p>
        </div>`;
      return;
    }

    productGrid.innerHTML = products.map(p => `
      <div class="product-card ${p.stock <= 0 ? 'out-of-stock' : ''}" onclick='addToCart(${JSON.stringify({id:p.id, name:p.name, sku:p.sku, selling_price:p.selling_price, stock:p.stock})})'>
        <div>
          <div class="p-name">${p.name}</div>
          <span class="p-sku">${p.sku}</span>
        </div>
        <div class="p-price-row">
          <div class="p-price">Rp ${fmt(p.selling_price)}</div>
          <div class="p-stock ${p.stock <= 5 ? 'low-stock' : ''}">
            ${p.stock <= 0 ? 'Habis' : 'Stok: ' + p.stock}
          </div>
        </div>
      </div>
    `).join('');
  }

  // === Cart Engine ===
  window.addToCart = function(product) {
    const existing = cart.find(c => c.product_id === product.id);
    if (existing) {
      if (existing.quantity + 1 > product.stock) {
        alert(`Stok "${product.name}" tidak mencukupi! (Sisa: ${product.stock})`);
        return;
      }
      existing.quantity += 1;
    } else {
      if (product.stock <= 0) {
        alert(`Stok "${product.name}" habis!`);
        return;
      }
      cart.push({
        product_id: product.id,
        name: product.name,
        sku: product.sku,
        price: parseFloat(product.selling_price),
        stock: parseFloat(product.stock),
        quantity: 1,
      });
    }
    renderCart();
  };

  function renderCart() {
    if (cart.length === 0) {
      cartItemsEl.innerHTML = '<div class="cart-empty" id="cartEmpty">Keranjang belanja masih kosong.<br>Pilih produk di sebelah kiri atau scan barcode.</div>';
      payBtn.disabled = true;
      clearCartBtn.style.display = 'none';
      if (paymentSection.classList.contains('active')) {
        cancelPayment();
      }
    } else {
      cartItemsEl.innerHTML = cart.map((item, idx) => `
        <div class="cart-item">
          <div class="ci-info">
            <div class="ci-name" title="${item.name}">${item.name}</div>
            <div class="ci-price">Rp ${fmt(item.price)}</div>
          </div>
          <div class="ci-stepper">
            <button type="button" class="stepper-btn" onclick="stepQty(${idx}, -1)">−</button>
            <input type="text" class="ci-qty-input" value="${item.quantity}" readonly>
            <button type="button" class="stepper-btn" onclick="stepQty(${idx}, 1)">+</button>
          </div>
          <div class="ci-subtotal">Rp ${fmt(item.price * item.quantity)}</div>
          <button type="button" class="ci-remove" onclick="removeItem(${idx})" title="Hapus Item">&times;</button>
        </div>
      `).join('');
      payBtn.disabled = false;
      clearCartBtn.style.display = 'flex';
    }

    const totalItems = cart.reduce((s, i) => s + i.quantity, 0);
    cartCount.textContent = `${totalItems} item`;
    if (mCartBadge) mCartBadge.textContent = totalItems;
    if (floatingItemCount) floatingItemCount.textContent = `${totalItems} Item`;
    calcTotals();
    updateFloatingBar();
  }

  window.stepQty = function(idx, delta) {
    const item = cart[idx];
    const newQty = item.quantity + delta;
    if (newQty <= 0) {
      cart.splice(idx, 1);
    } else if (newQty > item.stock) {
      alert(`Stok "${item.name}" hanya tersisa ${item.stock}!`);
    } else {
      item.quantity = newQty;
    }
    renderCart();
  };

  window.removeItem = function(idx) {
    cart.splice(idx, 1);
    renderCart();
  };

  clearCartBtn.addEventListener('click', () => {
    if (cart.length === 0) return;
    if (confirm('Kosongkan semua item di keranjang?')) {
      cart = [];
      renderCart();
      searchInput.focus();
    }
  });

  function getSubtotal() {
    return cart.reduce((s, i) => s + i.price * i.quantity, 0);
  }

  function getDiscount() {
    return parseFloat(discountInput.value) || 0;
  }

  function getTotal() {
    return Math.max(0, getSubtotal() - getDiscount());
  }

  function calcTotals() {
    const totalFormatted = `Rp ${fmt(getTotal())}`;
    cartSubtotal.textContent = `Rp ${fmt(getSubtotal())}`;
    cartTotal.textContent = totalFormatted;
    if (mCartSum) mCartSum.textContent = totalFormatted;
    if (floatingTotal) floatingTotal.textContent = totalFormatted;
    calcChange();
  }

  discountInput.addEventListener('input', calcTotals);

  // === Payment Workflow ===
  payBtn.addEventListener('click', startPayment);

  function startPayment() {
    if (cart.length === 0) return;
    payBtnSection.style.display = 'none';
    paymentSection.classList.add('active');
    
    // Default cash to exact total
    paidAmountInput.value = Math.ceil(getTotal());
    calcChange();

    // Smooth scroll down to payment area and focus cash input
    setTimeout(() => {
      posCartPanel.scrollTo({ top: posCartPanel.scrollHeight, behavior: 'smooth' });
      if (selectedMethod === 'cash') {
        paidAmountInput.focus();
        paidAmountInput.select();
      }
    }, 50);
  }

  cancelPayBtn.addEventListener('click', cancelPayment);

  function cancelPayment() {
    payBtnSection.style.display = 'block';
    paymentSection.classList.remove('active');
    checkoutBtn.disabled = true;
  }

  // Payment method switcher
  document.querySelectorAll('.pay-method-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pay-method-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedMethod = btn.dataset.method;
      
      const isCash = selectedMethod === 'cash';
      document.getElementById('cashSection').style.display = isCash ? 'block' : 'none';
      document.getElementById('refSection').style.display = isCash ? 'none' : 'block';
      
      if (!isCash) {
        checkoutBtn.disabled = false;
      } else {
        calcChange();
        paidAmountInput.focus();
        paidAmountInput.select();
      }
    });
  });

  // Quick cash buttons
  document.getElementById('btnExactCash').addEventListener('click', () => {
    paidAmountInput.value = Math.ceil(getTotal());
    calcChange();
    paidAmountInput.focus();
  });

  document.querySelectorAll('.quick-cash-btn[data-add]').forEach(btn => {
    btn.addEventListener('click', () => {
      const addVal = parseInt(btn.dataset.add);
      const cur = parseFloat(paidAmountInput.value) || 0;
      paidAmountInput.value = cur + addVal;
      calcChange();
      paidAmountInput.focus();
    });
  });

  paidAmountInput.addEventListener('input', calcChange);
  paidAmountInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !checkoutBtn.disabled) {
      e.preventDefault();
      checkoutBtn.click();
    }
  });

  function calcChange() {
    const total = getTotal();
    const paid = parseFloat(paidAmountInput.value) || 0;
    const change = paid - total;

    if (selectedMethod === 'cash') {
      if (paid >= total && total > 0) {
        changeDisplay.style.display = 'flex';
        changeAmount.textContent = `Rp ${fmt(change)}`;
        checkoutBtn.disabled = false;
      } else {
        changeDisplay.style.display = 'none';
        checkoutBtn.disabled = true;
      }
    }
  }

  // === Checkout Submission ===
  checkoutBtn.addEventListener('click', async () => {
    if (cart.length === 0) return;
    checkoutBtn.disabled = true;
    checkoutBtn.innerHTML = `
      <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
        <path d="M12 2a10 10 0 0 1 10 10"/>
      </svg>
      <span>Memproses Transaksi...</span>`;

    try {
      const res = await fetch('/api/sales/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map(i => ({ product_id: i.product_id, quantity: i.quantity })),
          payment_method: selectedMethod,
          paid_amount: selectedMethod === 'cash' ? paidAmountInput.value : getTotal(),
          discount: getDiscount(),
          reference_number: document.getElementById('refInput')?.value || '',
        }),
      });

      const data = await res.json();

      if (data.success) {
        showReceipt(data.data);
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (err) {
      alert('Terjadi kesalahan koneksi: ' + err.message);
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Proses Pembayaran</span>`;
    }
  });

  // === Receipt Dialog ===
  function showReceipt(sale) {
    document.getElementById('receiptInvoice').textContent = sale.invoice_number;
    document.getElementById('receiptDetails').innerHTML = `
      <table style="width:100%;font-size:0.875rem;border-collapse:collapse">
        ${sale.items.map(i => `
          <tr>
            <td style="padding:0.25rem 0">${i.product_name_snapshot}</td>
            <td style="text-align:right;color:#64748b">${i.quantity} x Rp ${fmt(i.unit_price)}</td>
            <td style="text-align:right;font-weight:700">Rp ${fmt(i.subtotal)}</td>
          </tr>
        `).join('')}
        <tr style="border-top:1px dashed #cbd5e1">
          <td colspan="2" style="padding-top:0.5rem;font-weight:700">Total Belanja</td>
          <td style="text-align:right;font-weight:800;font-size:1.05rem;color:#2563eb;padding-top:0.5rem">Rp ${fmt(sale.total)}</td>
        </tr>
        <tr>
          <td colspan="2" style="color:#64748b">Bayar (${sale.payment_method.toUpperCase()})</td>
          <td style="text-align:right">Rp ${fmt(sale.paid_amount)}</td>
        </tr>
        ${sale.change_amount > 0 ? `
          <tr>
            <td colspan="2" style="font-weight:700;color:#16a34a">Kembalian</td>
            <td style="text-align:right;font-weight:800;color:#16a34a">Rp ${fmt(sale.change_amount)}</td>
          </tr>` : ''}
      </table>
    `;
    const modal = document.getElementById('receiptModal');
    modal.style.display = 'flex';
  }

  document.getElementById('printReceiptBtn').addEventListener('click', () => {
    const invoiceNum = document.getElementById('receiptInvoice').textContent;
    window.open(`/transactions/${invoiceNum}/receipt`, '_blank', 'width=420,height=620');
  });

  document.getElementById('newTransactionBtn').addEventListener('click', resetNewTransaction);

  function resetNewTransaction() {
    cart = [];
    renderCart();
    discountInput.value = 0;
    cancelPayment();
    document.getElementById('receiptModal').style.display = 'none';
    searchInput.value = '';
    searchInput.focus();
  }

  // === Global Keyboard Shortcuts ===
  document.addEventListener('keydown', (e) => {
    // F2: Focus scanner
    if (e.key === 'F2') {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
    // F9: Open payment
    else if (e.key === 'F9') {
      e.preventDefault();
      if (!payBtn.disabled && payBtnSection.style.display !== 'none') {
        startPayment();
      }
    }
    // Esc: Cancel payment or close modal
    else if (e.key === 'Escape') {
      if (document.getElementById('receiptModal').style.display === 'flex') {
        resetNewTransaction();
      } else if (paymentSection.classList.contains('active')) {
        cancelPayment();
        searchInput.focus();
      }
    }
  });

  // Initial setup
  renderCart();
  searchInput.focus();
});
</script>
