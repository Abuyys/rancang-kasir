<div class="page-header">
  <div>
    <a href="/users" class="btn btn-secondary btn-sm" style="margin-bottom:0.5rem;display:inline-block">← Kembali ke Daftar Pengguna</a>
    <h1>🔑 Reset Password Pengguna</h1>
  </div>
</div>

<div class="card" style="max-width:500px">
  <div class="card-body">
    <div style="background:#f8fafc;padding:0.75rem 1rem;border-radius:6px;margin-bottom:1.25rem">
      <strong>Nama:</strong> <%= user.name %><br>
      <strong>Username:</strong> <code><%= user.username %></code><br>
      <strong>Role:</strong> <%= user.role === 'admin' ? 'Admin' : 'Kasir' %>
    </div>

    <form action="/users/<%= user.id %>/reset-password" method="POST">
      <div class="form-group">
        <label for="new_password">Password Baru <span style="color:red">*</span></label>
        <input type="password" id="new_password" name="new_password" class="form-control" minlength="6" required placeholder="Minimal 6 karakter" autofocus>
      </div>

      <div class="form-actions" style="margin-top:1.5rem">
        <button type="submit" class="btn btn-danger">Simpan Password Baru</button>
        <a href="/users" class="btn btn-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>
