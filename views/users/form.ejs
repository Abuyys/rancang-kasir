<div class="page-header">
  <div>
    <a href="/users" class="btn btn-secondary btn-sm" style="margin-bottom:0.5rem;display:inline-block">← Kembali ke Daftar Pengguna</a>
    <h1><%= user ? '✏️ Ubah Data Pengguna' : '➕ Tambah Pengguna Baru' %></h1>
  </div>
</div>

<div class="card" style="max-width:550px">
  <div class="card-body">
    <form action="<%= user ? `/users/${user.id}` : '/users' %>" method="POST">
      <div class="form-group">
        <label for="name">Nama Lengkap <span style="color:red">*</span></label>
        <input type="text" id="name" name="name" class="form-control" required placeholder="Contoh: Budi Santoso" value="<%= user ? user.name : '' %>" autofocus>
      </div>

      <div class="form-group">
        <label for="username">Username <span style="color:red">*</span></label>
        <input type="text" id="username" name="username" class="form-control" required placeholder="Contoh: budi123" value="<%= user ? user.username : '' %>" <%= user ? 'readonly style="background:#f1f5f9;cursor:not-allowed"' : '' %>>
        <% if (user) { %>
          <small class="text-muted">Username tidak dapat diubah setelah dibuat.</small>
        <% } %>
      </div>

      <% if (!user) { %>
      <div class="form-group">
        <label for="password">Password Awal <span style="color:red">*</span></label>
        <input type="password" id="password" name="password" class="form-control" minlength="6" required placeholder="Minimal 6 karakter">
      </div>
      <% } %>

      <div class="form-group">
        <label for="role">Role / Peran <span style="color:red">*</span></label>
        <select id="role" name="role" class="form-control" required>
          <option value="cashier" <%= user && user.role === 'cashier' ? 'selected' : '' %>>Kasir (Hanya POS & Riwayat Transaksi Sendiri)</option>
          <option value="admin" <%= user && user.role === 'admin' ? 'selected' : '' %>>Admin (Akses Penuh Seluruh Sistem)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="is_active">Status Akun</label>
        <select id="is_active" name="is_active" class="form-control">
          <option value="1" <%= !user || user.is_active ? 'selected' : '' %>>Aktif (Dapat Login)</option>
          <option value="0" <%= user && !user.is_active ? 'selected' : '' %>>Nonaktif (Tidak Dapat Login)</option>
        </select>
      </div>

      <div class="form-actions" style="margin-top:1.5rem">
        <button type="submit" class="btn btn-primary"><%= user ? 'Simpan Perubahan' : 'Buat Pengguna' %></button>
        <a href="/users" class="btn btn-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>
