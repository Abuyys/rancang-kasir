<header class="top-header">
  <div class="header-left">
    <button class="sidebar-toggle" id="sidebarToggle" title="Toggle Sidebar" aria-label="Toggle menu navigasi">
      ☰
    </button>
    <span class="mobile-brand-title">🏪 MiniPOS</span>
  </div>
  <div class="header-right">
    <!-- Dark Mode Toggle Button -->
    <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Ganti Tema Dark / Light (Alt + T)" aria-label="Toggle theme">
      <span class="theme-icon moon-icon"><svg id="moonSvg" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
		<!-- Moon shape: already at final position, no slide-in animation -->
		<path stroke-width="2" d="M7 6c0 6.08 4.92 11 11 11c0.53 0 1.05 -0.04 1.56 -0.11c-1.61 2.47 -4.39 4.11 -7.56 4.11c-4.97 0 -9 -4.03 -9 -9c0 -3.17 1.64 -5.95 4.11 -7.56c-0.07 0.51 -0.11 1.03 -0.11 1.56Z" />
		<!-- Sparkle stars: begin="indefinite" so they only play on hover -->
		<g stroke-dasharray="4" stroke-dashoffset="4">
			<path d="M12 5h1.5M12 5h-1.5M12 5v1.5M12 5v-1.5">
				<animate id="moonStar1" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M17 11h1.5M17 11h-1.5M17 11v1.5M17 11v-1.5">
				<animate id="moonStar2" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M20 5h1.5M20 5h-1.5M20 5v1.5M20 5v-1.5">
				<animate id="moonStar3" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M12 4h1.5M12 4h-1.5M12 4v1.5M12 4v-1.5">
				<animate id="moonStar4" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M18 12h1.5M18 12h-1.5M18 12v1.5M18 12v-1.5">
				<animate id="moonStar5" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M19 4h1.5M19 4h-1.5M19 4v1.5M19 4v-1.5">
				<animate id="moonStar6" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M13 4h1.5M13 4h-1.5M13 4v1.5M13 4v-1.5">
				<animate id="moonStar7" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M19 11h1.5M19 11h-1.5M19 11v1.5M19 11v-1.5">
				<animate id="moonStar8" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
			<path d="M20 5h1.5M20 5h-1.5M20 5v1.5M20 5v-1.5">
				<animate id="moonStar9" attributeName="stroke-dashoffset" begin="indefinite" dur="6s" keyTimes="0;0.08;0.22;0.3;1" repeatCount="indefinite" values="4;0;0;4;4" />
			</path>
		</g>
	</g>
</svg>
</span>
      <span class="theme-icon sun-icon"><svg id="sunSvg" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<defs>
		<mask id="SVGUXuaaerw">
			<!-- Final state `d` values, no auto-play animations -->
			<path fill="#fff" d="M12 6c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6Z">
				<animate id="sunMask1" fill="freeze" attributeName="d" begin="indefinite" dur="0.4s" values="M12 2c5.52 0 10 4.48 10 10c0 5.52 -4.48 10 -10 10c-5.52 0 -10 -4.48 -10 -10c0 -5.52 4.48 -10 10 -10Z;M12 6c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6Z" />
			</path>
			<path d="M22 -4c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6Z" opacity="0">
				<animate id="sunMask2" fill="freeze" attributeName="d" begin="indefinite" dur="0.4s" values="M18 -4c5.52 0 10 4.48 10 10c0 5.52 -4.48 10 -10 10c-5.52 0 -10 -4.48 -10 -10c0 -5.52 4.48 -10 10 -10Z;M22 -4c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6Z" />
			</path>
			<path d="M12 8c2.21 0 4 1.79 4 4c0 2.21 -1.79 4 -4 4c-2.21 0 -4 -1.79 -4 -4c0 -2.21 1.79 -4 4 -4Z">
				<animate id="sunMask3" fill="freeze" attributeName="d" begin="indefinite" dur="0.4s" values="M12 4c4.42 0 8 3.58 8 8c0 4.42 -3.58 8 -8 8c-4.42 0 -8 -3.58 -8 -8c0 -4.42 3.58 -8 8 -8Z;M12 8c2.21 0 4 1.79 4 4c0 2.21 -1.79 4 -4 4c-2.21 0 -4 -1.79 -4 -4c0 -2.21 1.79 -4 4 -4Z" />
			</path>
		</mask>
		<mask id="SVGjqg97bFZ">
			<path fill="#fff" d="M22 -6c4.42 0 8 3.58 8 8c0 4.42 -3.58 8 -8 8c-4.42 0 -8 -3.58 -8 -8c0 -4.42 3.58 -8 8 -8Z" opacity="0">
				<animate id="sunMask4" fill="freeze" attributeName="d" begin="indefinite" dur="0.4s" values="M18 -6c6.62 0 12 5.38 12 12c0 6.62 -5.38 12 -12 12c-6.62 0 -12 -5.38 -12 -12c0 -6.62 5.38 -12 12 -12Z;M22 -6c4.42 0 8 3.58 8 8c0 4.42 -3.58 8 -8 8c-4.42 0 -8 -3.58 -8 -8c0 -4.42 3.58 -8 8 -8Z" />
			</path>
			<path d="M22 -4c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6ZM6 12v-20h26v26h-20c3.31 0 6 -2.69 6 -6c0 -3.31 -2.69 -6 -6 -6c-3.31 0 -6 2.69 -6 6Z" opacity="0">
				<animate id="sunMask5" fill="freeze" attributeName="d" begin="indefinite" dur="0.4s" values="M18 -4c5.52 0 10 4.48 10 10c0 5.52 -4.48 10 -10 10c-5.52 0 -10 -4.48 -10 -10c0 -5.52 4.48 -10 10 -10ZM2 12v-20h30v30h-20c5.52 0 10 -4.48 10 -10c0 -5.52 -4.48 -10 -10 -10c-5.52 0 -10 4.48 -10 10Z;M22 -4c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6ZM6 12v-20h26v26h-20c3.31 0 6 -2.69 6 -6c0 -3.31 -2.69 -6 -6 -6c-3.31 0 -6 2.69 -6 6Z" />
			</path>
		</mask>
	</defs>
	<g fill="currentColor">
		<path d="M0 0h24v24H0z" mask="url(#SVGUXuaaerw)" />
		<path d="M0 0h24v24H0z" mask="url(#SVGjqg97bFZ)" />
	</g>
	<!-- Rays: visible by default, always rotating -->
	<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
		<path id="sunRays1" d="M12 21v1M21 12h1M12 3v-1M3 12h-1" opacity="1">
			<animateTransform id="sunRotate1" attributeName="transform" begin="indefinite" dur="30s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12" />
			<animate id="sunRays1Anim" fill="freeze" attributeName="d" begin="indefinite" dur="0.2s" values="M12 19v1M19 12h1M12 5v-1M5 12h-1;M12 21v1M21 12h1M12 3v-1M3 12h-1" />
		</path>
		<path id="sunRays2" d="M18.5 18.5l0.5 0.5M18.5 5.5l0.5 -0.5M5.5 5.5l-0.5 -0.5M5.5 18.5l-0.5 0.5" opacity="1">
			<animateTransform id="sunRotate2" attributeName="transform" begin="indefinite" dur="30s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12" />
			<animate id="sunRays2Anim" fill="freeze" attributeName="d" begin="indefinite" dur="0.2s" values="M17 17l0.5 0.5M17 7l0.5 -0.5M7 7l-0.5 -0.5M7 17l-0.5 0.5;M18.5 18.5l0.5 0.5M18.5 5.5l0.5 -0.5M5.5 5.5l-0.5 -0.5M5.5 18.5l-0.5 0.5" />
		</path>
	</g>
</svg>
</span>
      <span class="theme-btn-text" id="themeBtnText">Dark Mode</span>
    </button>

    <span class="user-info">
      <span class="user-role-badge badge-<%= currentUser.role %>"><%= currentUser.role === 'admin' ? 'Admin' : 'Kasir' %></span>
      <strong class="user-name-text"><%= currentUser.name %></strong>
    </span>
    <form action="/auth/logout" method="POST" style="display:inline;margin:0;">
      <button type="submit" class="btn btn-logout" title="Logout" aria-label="Keluar dari akun">
        <svg class="logout-svg" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
          <path d="M0 0h24v24H0z" fill="none" />
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
            <path class="logout-door" stroke-dasharray="46" stroke-dashoffset="0" d="M16 5v-1c0 -0.55 -0.45 -1 -1 -1h-9c-0.55 0 -1 0.45 -1 1v16c0 0.55 0.45 1 1 1h9c0.55 0 1 -0.45 1 -1v-1" />
            <path class="logout-arrow" stroke-dasharray="14" stroke-dashoffset="0" d="M10 12h11" />
            <path class="logout-arrowhead" stroke-dasharray="8" stroke-dashoffset="0" d="M21 12l-3.5 -3.5M21 12l-3.5 3.5" />
          </g>
        </svg>
        <span class="logout-text">Logout</span>
      </button>
      <style>
        @keyframes draw-door {
          from { stroke-dashoffset: 46; }
          to   { stroke-dashoffset: 0; }
        }
        @keyframes draw-arrow {
          from { stroke-dashoffset: 14; }
          to   { stroke-dashoffset: 0; }
        }
        @keyframes draw-arrowhead {
          from { stroke-dashoffset: 8; }
          to   { stroke-dashoffset: 0; }
        }
        .btn-logout:hover .logout-door {
          animation: draw-door 0.5s ease forwards;
        }
        .btn-logout:hover .logout-arrow {
          animation: draw-arrow 0.2s ease 0.6s both;
        }
        .btn-logout:hover .logout-arrowhead {
          animation: draw-arrowhead 0.2s ease 0.8s both;
        }
      </style>
    </form>

  <script>
    (function () {
      const themeBtn = document.getElementById('themeToggleBtn');
      if (!themeBtn) return;

      // IDs of moon sparkle animations
      const moonAnimIds = ['moonStar1','moonStar2','moonStar3','moonStar4','moonStar5','moonStar6','moonStar7','moonStar8','moonStar9'];
      // IDs of sun one-shot animations (including rotation)
      const sunAnimIds  = ['sunRotate1','sunRotate2','sunMask1','sunMask2','sunMask3','sunMask4','sunMask5','sunRays1Anim','sunRays2Anim'];

      function triggerAnims(ids) {
        ids.forEach(function(id) {
          var el = document.getElementById(id);
          if (el && el.beginElement) el.beginElement();
        });
      }

      function stopAnims(ids) {
        ids.forEach(function(id) {
          var el = document.getElementById(id);
          if (el && el.endElement) el.endElement();
        });
      }

      themeBtn.addEventListener('mouseenter', function () {
        // Trigger whichever icon is currently visible
        var moonVisible = themeBtn.querySelector('.moon-icon') &&
                          getComputedStyle(themeBtn.querySelector('.moon-icon')).display !== 'none';
        if (moonVisible) {
          triggerAnims(moonAnimIds);
        } else {
          triggerAnims(sunAnimIds);
        }
      });

      themeBtn.addEventListener('mouseleave', function () {
        // Stop looping animations when cursor leaves
        stopAnims(moonAnimIds);
        stopAnims(sunAnimIds);
      });
    })();
  </script>
  </div>
</header>
