<div class="page-header">
  <div>
    <h1>📦 Produk</h1>
    <p class="text-muted" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">Kelola katalog produk, cetak label barcode, dan generate barcode internal</p>
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% if (currentUser.role === 'admin') { %>
      <button type="button" class="btn btn-secondary" id="btnBulkGenerateBarcode" title="Generate barcode internal EAN-13 untuk semua produk yang belum punya barcode">
        ⚡ Generate Barcode Massal
      </button>
      <button type="button" class="btn btn-secondary" id="btnPrintSelectedLabels" title="Cetak label barcode untuk produk yang dicentang">
        🖨️ Cetak Label Terpilih (<span id="selectedCountBadge">0</span>)
      </button>
      <a href="/products/create" class="btn btn-primary">+ Tambah Produk</a>
    <% } %>
  </div>
</div>

<div class="card" style="margin-bottom: 1.5rem;">
  <div class="card-body">
    <form action="/products" method="GET" class="filter-form">
      <div class="filter-row" style="flex-wrap: wrap; gap: 0.75rem;">
        <div class="form-group" style="flex: 2; min-width: 200px; margin-bottom: 0;">
          <input type="text" name="search" placeholder="Cari nama, SKU, atau barcode..." 
            value="<%= filters.search || '' %>" class="form-control">
        </div>
        <div class="form-group" style="width: 170px; margin-bottom: 0;">
          <select name="category_id" class="form-control">
            <option value="">Semua Kategori</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= filters.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group" style="width: 130px; margin-bottom: 0;">
          <select name="status" class="form-control">
            <option value="">Semua Status</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Aktif</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
          </select>
        </div>
        <div class="form-group" style="width: 180px; margin-bottom: 0;">
          <select name="barcode_status" class="form-control">
            <option value="">Semua Barcode</option>
            <option value="with_barcode" <%= filters.barcode_status === 'with_barcode' ? 'selected' : '' %>>Punya Barcode</option>
            <option value="without_barcode" <%= filters.barcode_status === 'without_barcode' ? 'selected' : '' %>>Belum Punya Barcode</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Cari</button>
        <a href="/products" class="btn btn-secondary">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (products.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width:36px; text-align:center;">
              <input type="checkbox" id="selectAllProds" title="Pilih Semua" style="cursor:pointer; width:16px; height:16px;">
            </th>
            <th style="width:45px">#</th>
            <th>SKU</th>
            <th>Nama Produk & Barcode</th>
            <th>Kategori</th>
            <th style="text-align:right">Harga Jual</th>
            <th style="text-align:right">Stok</th>
            <th style="width:85px">Status</th>
            <th style="width:230px">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((prod, i) => { %>
          <tr class="<%= (prod.stock <= prod.min_stock && prod.is_active) ? 'row-warning' : '' %>">
            <td style="text-align:center;">
              <input type="checkbox" class="prod-select-chk" value="<%= prod.id %>" 
                data-has-barcode="<%= prod.barcode ? '1' : '0' %>" 
                data-name="<%= prod.name %>"
                style="cursor:pointer; width:16px; height:16px;">
            </td>
            <td><%= (pagination.page - 1) * 20 + i + 1 %></td>
            <td><code><%= prod.sku %></code></td>
            <td>
              <a href="/products/<%= prod.id %>"><strong><%= prod.name %></strong></a>
              <% if (prod.barcode) { %>
                <div style="margin-top: 3px; display: flex; align-items: center; gap: 0.35rem; font-size: 0.775rem;">
                  <span class="badge" style="background:#e0e7ff; color:#3730a3; font-family: monospace; font-size: 0.725rem;">
                    <%= prod.barcode %>
                  </span>
                  <% if (prod.barcode_type) { %>
                    <span style="font-size: 0.675rem; text-transform: uppercase; color: #64748b; font-weight: 700;">
                      (<%= prod.barcode_type %>)
                    </span>
                  <% } %>
                </div>
              <% } else { %>
                <div style="margin-top: 3px;">
                  <span class="badge" style="background:#fee2e2; color:#991b1b; font-size: 0.7rem;">
                    Belum ada barcode
                  </span>
                  <% if (currentUser.role === 'admin') { %>
                    <button type="button" class="btn btn-sm btn-link" style="padding:0;font-size:0.75rem;color:#2563eb;text-decoration:underline;border:none;background:none;cursor:pointer" onclick="generateSingleBarcode(<%= prod.id %>, '<%= prod.name.replace(/'/g, "\\'") %>')">
                      ⚡ Generate
                    </button>
                  <% } %>
                </div>
              <% } %>
            </td>
            <td><%= prod.category_name || '-' %></td>
            <td style="text-align:right">Rp <%= new Intl.NumberFormat('id-ID').format(prod.selling_price) %></td>
            <td style="text-align:right">
              <% if (prod.stock <= prod.min_stock && prod.is_active) { %>
                <span style="color:#dc2626;font-weight:bold"><%= prod.stock %></span> ⚠️
              <% } else { %>
                <%= prod.stock %>
              <% } %>
            </td>
            <td><span class="badge <%= prod.is_active ? 'badge-success' : 'badge-danger' %>"><%= prod.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
            <td>
              <div style="display:flex; gap:0.25rem; align-items:center; flex-wrap:wrap">
                <a href="/products/<%= prod.id %>" class="btn btn-sm btn-secondary" title="Detail">Detail</a>
                <% if (prod.barcode) { %>
                  <a href="/labels/print?ids=<%= prod.id %>" class="btn btn-sm btn-secondary" title="Cetak Label" target="_blank">🖨️</a>
                <% } %>
                <% if (currentUser.role === 'admin') { %>
                  <a href="/products/<%= prod.id %>/edit" class="btn btn-sm btn-secondary" title="Edit">Edit</a>
                  <form action="/products/<%= prod.id %>/toggle-status" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-sm <%= prod.is_active ? 'btn-danger' : 'btn-success' %>"
                      onclick="return confirm('<%= prod.is_active ? 'Nonaktifkan' : 'Aktifkan' %> produk ini?')">
                      <%= prod.is_active ? 'Off' : 'On' %>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pagination.totalPages > 1) { %>
    <div class="pagination">
      <% const qBase = `search=${encodeURIComponent(filters.search || '')}&category_id=${encodeURIComponent(filters.category_id || '')}&status=${encodeURIComponent(filters.status || '')}&barcode_status=${encodeURIComponent(filters.barcode_status || '')}`; %>
      <% if (pagination.page > 1) { %>
        <a href="/products?page=<%= pagination.page - 1 %>&<%= qBase %>" class="pagination-link">«</a>
      <% } %>
      <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
        <a href="/products?page=<%= p %>&<%= qBase %>" 
           class="pagination-link <%= p === pagination.page ? 'active' : '' %>"><%= p %></a>
      <% } %>
      <% if (pagination.page < pagination.totalPages) { %>
        <a href="/products?page=<%= pagination.page + 1 %>&<%= qBase %>" class="pagination-link">»</a>
      <% } %>
    </div>
    <% } %>
    <p class="text-muted" style="margin-top: 1rem;">Menampilkan <%= products.length %> dari <%= pagination.total %> produk</p>
    <% } else { %>
    <p class="text-muted">Tidak ada produk ditemukan. <% if (currentUser.role === 'admin') { %><a href="/products/create">Tambah produk pertama</a><% } %></p>
    <% } %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const selectAll = document.getElementById('selectAllProds');
  const checkboxes = document.querySelectorAll('.prod-select-chk');
  const countBadge = document.getElementById('selectedCountBadge');
  const btnPrint = document.getElementById('btnPrintSelectedLabels');
  const btnBulkGen = document.getElementById('btnBulkGenerateBarcode');

  function updateCount() {
    const checked = Array.from(checkboxes).filter(c => c.checked);
    if (countBadge) countBadge.textContent = checked.length;
  }

  if (selectAll) {
    selectAll.addEventListener('change', () => {
      checkboxes.forEach(c => c.checked = selectAll.checked);
      updateCount();
    });
  }

  checkboxes.forEach(c => {
    c.addEventListener('change', () => {
      if (!c.checked && selectAll) selectAll.checked = false;
      updateCount();
    });
  });

  // Print selected
  if (btnPrint) {
    btnPrint.addEventListener('click', () => {
      const checked = Array.from(checkboxes).filter(c => c.checked);
      if (checked.length === 0) {
        alert('Pilih minimal satu produk untuk mencetak label.');
        return;
      }
      const ids = checked.map(c => c.value);
      const withoutBarcode = checked.filter(c => c.dataset.hasBarcode === '0');
      if (withoutBarcode.length > 0) {
        if (!confirm(`Ada ${withoutBarcode.length} produk terpilih yang belum punya barcode. Lanjutkan cetak produk yang sudah berbarcode saja?`)) {
          return;
        }
      }
      window.open(`/labels/print?ids=${ids.join(',')}`, '_blank');
    });
  }

  // Bulk generate
  if (btnBulkGen) {
    btnBulkGen.addEventListener('click', async () => {
      if (!confirm('Generate barcode internal EAN-13 (prefix 200) untuk semua produk yang belum memiliki barcode?')) {
        return;
      }
      btnBulkGen.disabled = true;
      btnBulkGen.textContent = 'Memproses...';
      try {
        const res = await fetch('/api/products/barcode/generate-bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          alert(`Sukses: ${data.message}`);
          window.location.reload();
        } else {
          alert(`Gagal: ${data.message}`);
        }
      } catch (err) {
        alert(`Terjadi kesalahan: ${err.message}`);
      } finally {
        btnBulkGen.disabled = false;
        btnBulkGen.textContent = '⚡ Generate Barcode Massal';
      }
    });
  }
});

// Single product barcode generator
async function generateSingleBarcode(productId, productName) {
  if (!confirm(`Buat barcode internal EAN-13 untuk produk "${productName}"?`)) {
    return;
  }
  try {
    const res = await fetch(`/api/products/${productId}/barcode/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      alert(`Barcode berhasil dibuat: ${data.data.barcode}`);
      window.location.reload();
    } else {
      alert(`Gagal: ${data.message}`);
    }
  } catch (err) {
    alert(`Terjadi kesalahan: ${err.message}`);
  }
}
</script>
