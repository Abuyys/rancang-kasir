<div class="page-header">
  <div>
    <h1><%= product ? '✏️ Edit Produk' : '➕ Tambah Produk' %></h1>
    <p class="text-muted" style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">
      <%= product ? 'Perbarui informasi produk, harga, dan barcode' : 'Daftarkan produk baru ke dalam katalog sistem minimarket' %>
    </p>
  </div>
  <div style="display:flex;gap:0.5rem">
    <% if (product && product.barcode) { %>
      <a href="/labels/print?ids=<%= product.id %>" class="btn btn-secondary" target="_blank" title="Cetak label barcode">🖨️ Cetak Label</a>
    <% } %>
    <a href="/products" class="btn btn-secondary">← Kembali</a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form action="<%= product ? '/products/' + product.id : '/products' %>" method="POST" id="productForm" style="max-width: 780px;">
      
      <div class="form-row">
        <div class="form-group" style="flex:1">
          <label for="category_id">Kategori <span style="color:red">*</span></label>
          <select id="category_id" name="category_id" class="form-control" required>
            <option value="">-- Pilih Kategori --</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= (product && product.category_id == cat.id) ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group" style="flex:1">
          <label for="unit">Satuan</label>
          <select id="unit" name="unit" class="form-control">
            <% ['pcs','kg','gram','liter','ml','pack','box','botol','sachet','lusin'].forEach(u => { %>
              <option value="<%= u %>" <%= (product && product.unit === u) ? 'selected' : '' %>><%= u %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group" style="flex:1">
          <label for="sku">SKU <span style="color:red">*</span></label>
          <input type="text" id="sku" name="sku" class="form-control" placeholder="Contoh: MKN-001" required value="<%= product ? product.sku : '' %>">
        </div>
        
        <!-- Barcode Field & Controls -->
        <div class="form-group" style="flex:1.3">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem">
            <label for="barcode" style="margin-bottom:0">Barcode Produk</label>
            <div style="display:flex;gap:0.35rem">
              <button type="button" class="btn btn-sm btn-secondary" id="btnGenBarcode" style="font-size:0.75rem;padding:0.2rem 0.5rem" title="Generate barcode internal EAN-13">
                ⚡ Generate
              </button>
              <button type="button" class="btn btn-sm btn-secondary" id="btnOpenCamScan" style="font-size:0.75rem;padding:0.2rem 0.5rem" title="Scan dengan kamera">
                📷 Kamera
              </button>
            </div>
          </div>
          <input type="text" id="barcode" name="barcode" class="form-control" placeholder="Scan atau ketik barcode..." value="<%= product ? (product.barcode || '') : '' %>" autocomplete="off">
          <small class="text-muted" id="barcodeHint" style="font-size:0.75rem;display:block;margin-top:0.25rem">
            Mendukung EAN-13, EAN-8, UPC-A, dan Code128. Kosongkan lalu klik <b>Generate</b> untuk barcode internal.
          </small>
        </div>
      </div>

      <!-- Realtime Barcode Image Preview Card -->
      <div id="barcodePreviewCard" style="display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:0.85rem 1rem;margin-bottom:1.25rem">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;flex-wrap:wrap;gap:0.5rem">
          <div style="display:flex;align-items:center;gap:0.5rem">
            <span style="font-weight:700;font-size:0.85rem;color:#1e293b">Pratinjau Barcode:</span>
            <span id="barcodeTypeBadge" class="badge" style="background:#e0e7ff;color:#3730a3;font-size:0.725rem">EAN-13</span>
          </div>
          <div style="display:flex;gap:0.35rem">
            <button type="button" class="btn btn-sm btn-secondary" id="btnDownloadSvg" style="font-size:0.725rem;padding:0.2rem 0.5rem">
              ⬇ Unduh SVG
            </button>
            <button type="button" class="btn btn-sm btn-secondary" id="btnDownloadPng" style="font-size:0.725rem;padding:0.2rem 0.5rem">
              ⬇ Unduh PNG
            </button>
          </div>
        </div>
        <div style="background:#ffffff;border:1px dashed #cbd5e1;border-radius:8px;padding:0.75rem;text-align:center;min-height:75px;display:flex;align-items:center;justify-content:center" id="barcodeSvgContainer">
          <span style="color:#94a3b8;font-size:0.85rem">Memuat gambar barcode...</span>
        </div>
      </div>

      <div class="form-group">
        <label for="name">Nama Produk <span style="color:red">*</span></label>
        <input type="text" id="name" name="name" class="form-control" placeholder="Contoh: Indomie Goreng" required value="<%= product ? product.name : '' %>">
      </div>

      <div class="form-row">
        <div class="form-group" style="flex:1">
          <label for="cost_price">Harga Modal (Rp)</label>
          <input type="number" id="cost_price" name="cost_price" class="form-control" step="1" min="0" placeholder="0" value="<%= product ? product.cost_price : '' %>">
        </div>
        <div class="form-group" style="flex:1">
          <label for="selling_price">Harga Jual (Rp) <span style="color:red">*</span></label>
          <input type="number" id="selling_price" name="selling_price" class="form-control" step="1" min="1" placeholder="0" required value="<%= product ? product.selling_price : '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group" style="flex:1">
          <label for="min_stock">Stok Minimum</label>
          <input type="number" id="min_stock" name="min_stock" class="form-control" step="1" min="0" placeholder="0" value="<%= product ? product.min_stock : '0' %>">
        </div>
        <div class="form-group" style="flex:1">
          <label>Status</label>
          <div style="padding-top:8px">
            <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer">
              <input type="checkbox" name="is_active" value="1" <%= (!product || product.is_active) ? 'checked' : '' %>> Produk Aktif
            </label>
          </div>
        </div>
      </div>

      <div class="form-actions" style="margin-top:1.5rem">
        <button type="submit" class="btn btn-primary"><%= product ? 'Simpan Perubahan' : 'Tambah Produk' %></button>
        <a href="/products" class="btn btn-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>

<!-- Camera Scanner Modal -->
<div id="cameraModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.7);backdrop-filter:blur(3px);z-index:99999;align-items:center;justify-content:center;padding:1rem">
  <div style="background:#ffffff;border-radius:16px;max-width:440px;width:100%;padding:1.25rem;box-shadow:0 20px 25px -5px rgba(0,0,0,0.3);position:relative">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem">
      <div style="display:flex;align-items:center;gap:0.4rem;font-weight:800;font-size:1rem;color:#0f172a">
        <span>📷</span>
        <span>Pindai Barcode Produk</span>
      </div>
      <button type="button" id="btnCloseCam" title="Tutup (Esc)" style="width:34px;height:34px;border-radius:50%;background:#f1f5f9;border:1px solid #cbd5e1;display:inline-flex;align-items:center;justify-content:center;font-size:1.35rem;color:#334155;cursor:pointer;line-height:1">&times;</button>
    </div>

    <!-- Viewfinder Area -->
    <div id="camReader" style="width:100%;min-height:260px;background:#0f172a;border-radius:10px;overflow:hidden;position:relative"></div>
    
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.75rem">
      <button type="button" id="btnToggleTorch" class="btn btn-sm btn-secondary" style="font-size:0.75rem;display:none">
        🔦 Senter
      </button>
      <span style="font-size:0.775rem;color:#64748b;margin-left:auto">Arahkan barcode ke dalam bingkai kamera</span>
    </div>

    <div id="camStatusMsg" style="margin-top:0.65rem;font-size:0.825rem;color:#dc2626;display:none;text-align:center;line-height:1.4"></div>

    <div style="display:flex;gap:0.5rem;margin-top:0.85rem;justify-content:center">
      <button type="button" id="btnBottomCloseCam" class="btn btn-sm btn-secondary" style="font-weight:700;padding:0.4rem 1rem">Tutup</button>
    </div>
  </div>
</div>

<script src="/js/html5-qrcode.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const barcodeInput = document.getElementById('barcode');
  const previewCard = document.getElementById('barcodePreviewCard');
  const svgContainer = document.getElementById('barcodeSvgContainer');
  const typeBadge = document.getElementById('barcodeTypeBadge');
  const btnGen = document.getElementById('btnGenBarcode');
  const btnOpenCam = document.getElementById('btnOpenCamScan');
  const btnCloseCam = document.getElementById('btnCloseCam');
  const cameraModal = document.getElementById('cameraModal');
  const camStatusMsg = document.getElementById('camStatusMsg');
  const btnToggleTorch = document.getElementById('btnToggleTorch');
  const btnDownloadSvg = document.getElementById('btnDownloadSvg');
  const btnDownloadPng = document.getElementById('btnDownloadPng');

  const productId = <%= product ? product.id : 'null' %>;
  let previewTimeout;
  let html5QrCode = null;
  let isTorchOn = false;

  // Sound effects via Web Audio API synth
  const audioCtx = window.AudioContext || window.webkitAudioContext ? new (window.AudioContext || window.webkitAudioContext)() : null;
  function playBeep(freq = 1200, duration = 80) {
    if (!audioCtx) return;
    try {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + (duration / 1000));
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + (duration / 1000));
    } catch (e) {}
  }

  // --- Realtime Barcode Preview ---
  barcodeInput.addEventListener('input', () => {
    clearTimeout(previewTimeout);
    previewTimeout = setTimeout(refreshPreview, 300);
  });

  async function refreshPreview() {
    const val = barcodeInput.value.trim();
    if (!val) {
      previewCard.style.display = 'none';
      return;
    }

    previewCard.style.display = 'block';
    svgContainer.innerHTML = '<span style="color:#94a3b8;font-size:0.85rem">Memuat...</span>';

    try {
      const res = await fetch(`/api/barcode/render?text=${encodeURIComponent(val)}&format=svg&scale=2&height=12`);
      if (res.ok) {
        const svgText = await res.text();
        svgContainer.innerHTML = svgText;
        
        // Detect source & type
        let label = 'Code128';
        if (/^\d{13}$/.test(val)) {
          label = val.startsWith('200') ? 'EAN-13 (Internal)' : 'EAN-13 (Pabrik)';
        } else if (/^\d{8}$/.test(val)) {
          label = 'EAN-8';
        } else if (/^\d{12}$/.test(val)) {
          label = 'UPC-A';
        }
        typeBadge.textContent = label;
      } else {
        const err = await res.json();
        svgContainer.innerHTML = `<span style="color:#dc2626;font-size:0.825rem">${err.message || 'Format barcode tidak valid'}</span>`;
        typeBadge.textContent = 'Invalid';
      }
    } catch (e) {
      svgContainer.innerHTML = '<span style="color:#dc2626;font-size:0.825rem">Gagal memuat pratinjau</span>';
    }
  }

  // Initial preview if barcode exists
  if (barcodeInput.value.trim()) {
    refreshPreview();
  }

  // --- Download Barcode Handlers ---
  btnDownloadSvg.addEventListener('click', () => {
    const val = barcodeInput.value.trim();
    if (!val) return;
    const a = document.createElement('a');
    a.href = `/api/barcode/render?text=${encodeURIComponent(val)}&format=svg&scale=3&height=15`;
    a.download = `barcode-${val}.svg`;
    a.target = '_blank';
    a.click();
  });

  btnDownloadPng.addEventListener('click', () => {
    const val = barcodeInput.value.trim();
    if (!val) return;
    const a = document.createElement('a');
    a.href = `/api/barcode/render?text=${encodeURIComponent(val)}&format=png&scale=3&height=15`;
    a.download = `barcode-${val}.png`;
    a.target = '_blank';
    a.click();
  });

  // --- Generate Barcode Button ---
  btnGen.addEventListener('click', async () => {
    btnGen.disabled = true;
    btnGen.textContent = '...';

    try {
      if (productId) {
        // Existing product
        const res = await fetch(`/api/products/${productId}/barcode/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success && data.data) {
          barcodeInput.value = data.data.barcode;
          playBeep(900, 60);
          refreshPreview();
        } else {
          alert('Gagal: ' + data.message);
        }
      } else {
        // New product: fetch next internal barcode
        const res = await fetch('/api/barcode/next-internal');
        const data = await res.json();
        if (data.success && data.data) {
          barcodeInput.value = data.data.barcode;
          playBeep(900, 60);
          refreshPreview();
        } else {
          alert('Gagal: ' + data.message);
        }
      }
    } catch (err) {
      alert('Terjadi kesalahan: ' + err.message);
    } finally {
      btnGen.disabled = false;
      btnGen.textContent = '⚡ Generate';
    }
  });

  // --- Camera Scanner Integration (html5-qrcode) ---
  const btnBottomCloseCam = document.getElementById('btnBottomCloseCam');

  btnOpenCam.addEventListener('click', () => {
    cameraModal.style.display = 'flex';
    camStatusMsg.style.display = 'none';
    startCamera();
  });

  function stopCamera() {
    // 1. Immediately hide UI
    cameraModal.style.display = 'none';
    btnToggleTorch.style.display = 'none';
    isTorchOn = false;

    // 2. Safely stop scanner
    if (html5QrCode) {
      const qr = html5QrCode;
      html5QrCode = null;
      try {
        if (typeof qr.isScanning === 'boolean' ? qr.isScanning : true) {
          qr.stop().catch(() => {}).finally(() => {
            try { qr.clear(); } catch (e) {}
          });
        } else {
          try { qr.clear(); } catch (e) {}
        }
      } catch (err) {}
    }
  }

  btnCloseCam.addEventListener('click', stopCamera);
  if (btnBottomCloseCam) btnBottomCloseCam.addEventListener('click', stopCamera);
  cameraModal.addEventListener('click', (e) => {
    if (e.target === cameraModal) stopCamera();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cameraModal && cameraModal.style.display === 'flex') {
      stopCamera();
    }
  });

  async function startCamera() {
    if (!window.Html5Qrcode) {
      camStatusMsg.textContent = 'Pustaka scanner kamera belum siap.';
      camStatusMsg.style.display = 'block';
      return;
    }

    if (html5QrCode) {
      try {
        await html5QrCode.stop().catch(() => {});
        html5QrCode.clear();
      } catch (e) {}
      html5QrCode = null;
    }

    const isLocalhost = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    const isHttps = window.location.protocol === 'https:';
    if (!isLocalhost && !isHttps) {
      camStatusMsg.innerHTML = '⚠️ <b>Kamera membutuhkan HTTPS atau localhost.</b><br>' +
        'Jika membuka dari HP melalui IP (' + window.location.host + '), browser memblokir kamera demi privasi.';
      camStatusMsg.style.display = 'block';
      return;
    }

    html5QrCode = new Html5Qrcode("camReader");
    const config = {
      fps: 15,
      qrbox: { width: 260, height: 160 },
      aspectRatio: 1.0,
      experimentalFeatures: {
        useBarCodeDetectorIfSupported: true
      }
    };

    try {
      let cameraSource = { facingMode: "environment" };
      try {
        const cams = await Html5Qrcode.getCameras();
        if (cams && cams.length > 0) {
          const back = cams.find(c => {
            const l = (c.label || '').toLowerCase();
            return l.includes('back') || l.includes('rear') || l.includes('belakang') || l.includes('environment');
          });
          cameraSource = back ? back.id : cams[0].id;
        }
      } catch (e) {}

      await html5QrCode.start(
        cameraSource,
        config,
        (decodedText) => {
          playBeep(1200, 100);
          if (navigator.vibrate) navigator.vibrate([80]);
          barcodeInput.value = decodedText.trim();
          stopCamera();
          refreshPreview();
        },
        () => {}
      );

      try {
        const capabilities = html5QrCode.getRunningTrackCapabilities();
        if (capabilities && capabilities.torch) {
          btnToggleTorch.style.display = 'inline-block';
        }
      } catch (e) {}
    } catch (err) {
      const msg = err.message || '';
      if (err.name === 'NotAllowedError' || msg.includes('Permission denied') || msg.includes('denied')) {
        camStatusMsg.innerHTML = '🚫 <b>Izin kamera diblokir di browser.</b><br>Izinkan akses kamera di ikon gembok URL browser.';
      } else if (err.name === 'NotFoundError' || msg.includes('Requested device not found') || msg.includes('not found')) {
        camStatusMsg.innerHTML = '📷 <b>Tidak ada kamera/webcam di komputer ini.</b><br>Ketik barcode atau gunakan scanner barcode USB.';
      } else {
        camStatusMsg.innerHTML = '⚠️ <b>Akses kamera gagal:</b> ' + (msg || 'Kamera tidak tersedia.');
      }
      camStatusMsg.style.display = 'block';
    }
  }

  btnToggleTorch.addEventListener('click', () => {
    if (html5QrCode) {
      isTorchOn = !isTorchOn;
      html5QrCode.applyVideoConstraints({
        advanced: [{ torch: isTorchOn }]
      }).catch(() => {});
    }
  });
});
</script>
