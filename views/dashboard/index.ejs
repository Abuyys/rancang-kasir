    <a href="/transactions" class="quick-card">
      <div class="quick-icon-wrap" style="background:#ecfdf5;color:#059669">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
      </div>
      <div class="quick-card-text">
        <span class="quick-card-title">Riwayat</span>
        <span class="quick-card-desc">Struk & Retur</span>
      </div>
    </a>

    <% if (currentUser.role === 'admin') { %>
      <a href="/reports" class="quick-card">
        <div class="quick-icon-wrap" style="background:#e0f2fe;color:#0284c7">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
          </svg>
        </div>
        <div class="quick-card-text">
          <span class="quick-card-title">Laporan</span>
          <span class="quick-card-desc">Laba & Rugi</span>
        </div>
      </a>

      <a href="/purchases/create" class="quick-card">
        <div class="quick-icon-wrap" style="background:#fef3c7;color:#d97706">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </div>
        <div class="quick-card-text">
          <span class="quick-card-title">Pembelian</span>
          <span class="quick-card-desc">Restock Masuk</span>
        </div>
      </a>

      <a href="/expenses" class="quick-card">
        <div class="quick-icon-wrap" style="background:#fee2e2;color:#dc2626">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <div class="quick-card-text">
          <span class="quick-card-title">Pengeluaran</span>
          <span class="quick-card-desc">Biaya Toko</span>
        </div>
      </a>

      <a href="/inventory" class="quick-card">
        <div class="quick-icon-wrap" style="background:#f1f5f9;color:#475569">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
          </svg>
        </div>
        <div class="quick-card-text">
          <span class="quick-card-title">Opname Stok</span>
          <span class="quick-card-desc">Audit Fisik</span>
        </div>
      </a>
    <% } %>

    <a href="/shifts" class="quick-card">
      <div class="quick-icon-wrap" style="background:#ecfeff;color:#0891b2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="quick-card-text">
        <span class="quick-card-title">Shift Kasir</span>
        <span class="quick-card-desc">Buka & Tutup</span>
      </div>
    </a>
  </div>

  <!-- 3. Key Performance Indicators (KPI Cards) -->
  <div class="kpi-row">
    <!-- Card 1: Omzet Hari Ini -->
    <div class="metric-card card-revenue">
      <div class="metric-top">
        <div class="metric-label-group">
          <span class="metric-label">Omzet Penjualan</span>
        </div>
        <div class="metric-icon-box" style="background:#eff6ff;color:#2563eb">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
      </div>
      <div class="metric-value-box">
        <div class="metric-value">
          Rp <%= new Intl.NumberFormat('id-ID').format(metrics.revenue) %>
        </div>
      </div>
      <div class="metric-footer">
        <span class="metric-pill" style="background:#dbeafe;color:#1e40af">
          <%= metrics.transactions %> Transaksi
        </span>
        <span title="Tunai: Rp <%= new Intl.NumberFormat('id-ID').format(metrics.cashRevenue || 0) %>">
          Tunai: Rp <%= new Intl.NumberFormat('id-ID', { notation: 'compact' }).format(metrics.cashRevenue || 0) %>
        </span>
      </div>
    </div>

    <!-- Card 2: Laba Kotor Estimasi (Admin Only) or Nilai Transaksi -->
    <% if (currentUser.role === 'admin') { %>
      <div class="metric-card card-profit">
        <div class="metric-top">
          <div class="metric-label-group">
            <span class="metric-label">Estimasi Laba Kotor</span>
          </div>
          <div class="metric-icon-box" style="background:#f0fdf4;color:#16a34a">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
          </div>
        </div>
        <div class="metric-value-box">
          <div class="metric-value" style="color:#15803d">
            Rp <%= new Intl.NumberFormat('id-ID').format(metrics.profit) %>
          </div>
        </div>
        <div class="metric-footer">
          <span class="metric-pill" style="background:#dcfce7;color:#166534">
            Margin Toko
          </span>
          <span>Setelah HPP Produk</span>
        </div>
      </div>
    <% } %>

    <!-- Card 3: Rata-Rata Keranjang (AOV) -->
    <div class="metric-card card-aov">
      <div class="metric-top">
        <div class="metric-label-group">
          <span class="metric-label">Rata-Rata Belanja</span>
        </div>
        <div class="metric-icon-box" style="background:#fffbeb;color:#d97706">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
        </div>
      </div>
      <div class="metric-value-box">
        <div class="metric-value">
          Rp <%= new Intl.NumberFormat('id-ID').format(Math.round(metrics.avgOrderValue)) %>
        </div>
      </div>
      <div class="metric-footer">
        <span class="metric-pill" style="background:#fef3c7;color:#92400e">
          AOV
        </span>
        <span>Per Keranjang Struk</span>
      </div>
    </div>

    <!-- Card 4: Katalog Produk Aktif -->
    <div class="metric-card card-products">
      <div class="metric-top">
        <div class="metric-label-group">
          <span class="metric-label">Katalog Produk</span>
        </div>
        <div class="metric-icon-box" style="background:#faf5ff;color:#7c3aed">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
            <path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
          </svg>
        </div>
      </div>
      <div class="metric-value-box">
        <div class="metric-value">
          <%= metrics.totalProducts %> <span style="font-size:1rem;color:#64748b;font-weight:600">Item</span>
        </div>
      </div>
      <div class="metric-footer">
        <span class="metric-pill" style="background:#ede9fe;color:#5b21b6">
          Aktif Dijual
        </span>
        <span>Tersedia di Register POS</span>
      </div>
    </div>

    <!-- Card 5: Peringatan Stok Kritis -->
    <div class="metric-card <%= metrics.lowStockCount > 0 ? 'card-alert-danger' : 'card-alert-safe' %>">
      <div class="metric-top">
        <div class="metric-label-group">
          <span class="metric-label">Status Persediaan</span>
        </div>
        <div class="metric-icon-box" style="background:<%= metrics.lowStockCount > 0 ? '#fef2f2' : '#f0fdf4' %>;color:<%= metrics.lowStockCount > 0 ? '#dc2626' : '#16a34a' %>">
          <% if (metrics.lowStockCount > 0) { %>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          <% } else { %>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>
            </svg>
          <% } %>
        </div>
      </div>
      <div class="metric-value-box">
        <div class="metric-value" style="color:<%= metrics.lowStockCount > 0 ? '#b91c1c' : '#15803d' %>">
          <%= metrics.lowStockCount > 0 ? metrics.lowStockCount + ' SKU' : 'Aman' %>
        </div>
      </div>
      <div class="metric-footer">
        <% if (metrics.lowStockCount > 0) { %>
          <span class="metric-pill" style="background:#fee2e2;color:#991b1b">
            Stok Kritis
          </span>
          <span style="color:#b91c1c;font-weight:600">Perlu reorder supplier</span>
        <% } else { %>
          <span class="metric-pill" style="background:#dcfce7;color:#166534">
            Optimum
          </span>
          <span>Semua di atas minimum</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 4. Main Split: 7-Day Chart & Active Shifts / Top Products -->
  <div class="grid-two-split">
    
    <!-- LEFT COLUMN: Sales Trend Area Chart & Live Recent Transactions -->
    <div style="display:flex;flex-direction:column;gap:1.35rem">
      
      <!-- Chart Panel -->
      <div class="dash-panel">
        <div class="dash-panel-header">
          <div class="dash-panel-title">
            <span class="title-icon" style="background:#eff6ff;color:#2563eb">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
            </span>
            <div>
              <h2>Tren Penjualan 7 Hari Terakhir</h2>
            </div>
          </div>
          <div class="chart-stats-summary">
            <div class="chart-stat-chip">
              <span>Total 7 Hari:</span>
              <strong>Rp <%= new Intl.NumberFormat('id-ID').format(chart.weeklyTotalRevenue || 0) %></strong>
            </div>
            <div class="chart-stat-chip">
              <span>Transaksi:</span>
              <strong><%= chart.weeklyTotalTransactions || 0 %> struk</strong>
            </div>
          </div>
        </div>
        <div class="dash-panel-body">
          <div style="position:relative;height:290px;width:100%">
            <canvas id="salesAnalyticsChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Live Recent Sales Activity Feed -->
      <div class="dash-panel">
        <div class="dash-panel-header">
          <div class="dash-panel-title">
            <span class="title-icon" style="background:#ecfdf5;color:#059669">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </span>
            <div>
              <h2>Transaksi Penjualan Terkini</h2>
            </div>
          </div>
          <a href="/transactions" style="font-size:0.825rem;font-weight:700;color:#2563eb;text-decoration:none">
            Semua Transaksi →
          </a>
        </div>
        <div class="dash-panel-body" style="padding:0">
          <% if (typeof recentTransactions !== 'undefined' && recentTransactions && recentTransactions.length > 0) { %>
            <div class="table-responsive">
              <table class="recent-sales-table">
                <thead>
                  <tr>
                    <th style="padding-left:1.45rem">No. Struk</th>
                    <th>Waktu</th>
                    <th>Kasir</th>
                    <th>Metode</th>
                    <th style="text-align:right">Total Belanja</th>
                    <th style="text-align:center;padding-right:1.45rem">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentTransactions.forEach(tx => { %>
                    <tr>
                      <td style="padding-left:1.45rem">
                        <span class="invoice-pill"><%= tx.invoice_number %></span>
                      </td>
                      <td class="recent-tx-time">
                        <%= new Date(tx.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                      </td>
                      <td class="recent-tx-cashier">
                        <%= tx.cashier_name %>
                      </td>
                      <td>
                        <% if (tx.payment_method === 'cash') { %>
                          <span class="pay-chip pay-cash">Tunai</span>
                        <% } else if (tx.payment_method === 'qris') { %>
                          <span class="pay-chip pay-qris">QRIS</span>
                        <% } else if (tx.payment_method === 'debit') { %>
                          <span class="pay-chip pay-debit">Debit</span>
                        <% } else if (tx.payment_method === 'transfer') { %>
                          <span class="pay-chip pay-transfer">Transfer</span>
                        <% } else { %>
                          <span class="pay-chip pay-other"><%= tx.payment_method %></span>
                        <% } %>
                      </td>
                      <td class="recent-tx-total">
                        Rp <%= new Intl.NumberFormat('id-ID').format(tx.total) %>
                      </td>
                      <td style="text-align:center;padding-right:1.45rem">
                        <a href="/transactions/<%= tx.id %>" class="btn btn-sm btn-secondary" style="padding:0.25rem 0.65rem;font-size:0.775rem;border-radius:6px">
                          Lihat
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="dash-empty-state">
              <div class="dash-empty-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
              </div>
              <p style="font-weight:600;margin:0 0 0.35rem;color:var(--dash-text-main)">Belum ada transaksi</p>
              <span style="font-size:0.8rem">Buka register POS untuk melayani pelanggan pertama.</span>
            </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Active Shift, Top Selling Products, & Stock Alerts -->
    <div style="display:flex;flex-direction:column;gap:1.35rem">
      
      <!-- Active Shift Panel -->
      <div class="dash-panel">
        <div class="dash-panel-header">
          <div class="dash-panel-title">
            <span class="title-icon" style="background:#f0fdf4;color:#16a34a">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <div>
              <h2>Status Shift Kasir</h2>
            </div>
          </div>
          <a href="/shifts" style="font-size:0.825rem;color:#64748b;font-weight:600;text-decoration:none">
            Kelola Shift
          </a>
        </div>
        <div class="dash-panel-body">
          <% if (activeShifts && activeShifts.length > 0) { %>
            <div style="display:flex;flex-direction:column;gap:0.75rem">
              <% activeShifts.forEach(s => { %>
                <div class="active-shift-card">
                  <div style="display:flex;align-items:center;gap:0.85rem">
                    <div class="shift-avatar-ring">
                      <%= (s.cashier_name || 'K').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div class="shift-info-title"><%= s.cashier_name %></div>
                      <div class="shift-info-sub">
                        Mulai: <%= new Date(s.opened_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB
                      </div>
                    </div>
                  </div>
                  <div style="text-align:right">
                    <span class="shift-badge-active">
                      <span class="hero-pulse-dot" style="width:5px;height:5px"></span>
                      Register Dibuka
                    </span>
                    <div style="font-size:0.775rem;font-weight:700;color:var(--dash-text-main);margin-top:0.35rem">
                      Modal: Rp <%= new Intl.NumberFormat('id-ID').format(s.opening_cash) %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="dash-empty-shift-box" style="text-align:center;padding:1.75rem 1rem;background:#f8fafc;border-radius:14px;border:1px dashed #cbd5e1">
              <div style="font-size:1.75rem;margin-bottom:0.4rem">🔒</div>
              <div style="font-weight:800;color:var(--dash-text-main);font-size:0.95rem">Register Kasir Ditutup</div>
              <p style="font-size:0.8rem;color:var(--dash-text-muted);margin:0.25rem 0 1rem">Tidak ada shift yang sedang bertugas saat ini.</p>
              <a href="/shifts/open" class="btn btn-sm btn-primary" style="font-weight:700;border-radius:8px;padding:0.45rem 1rem">
                ▶ Buka Shift Kasir
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Top Selling Products Panel -->
      <div class="dash-panel">
        <div class="dash-panel-header">
          <div class="dash-panel-title">
            <span class="title-icon" style="background:#fef3c7;color:#d97706">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
              </svg>
            </span>
            <div>
              <h2>Produk Terlaris Minggu Ini</h2>
            </div>
          </div>
          <% if (currentUser.role === 'admin') { %>
            <a href="/reports" style="font-size:0.825rem;color:#2563eb;font-weight:700;text-decoration:none">
              Laporan Lengkap →
            </a>
          <% } %>
        </div>
        <div class="dash-panel-body">
          <% if (topProducts && topProducts.length > 0) { %>
            <div class="top-prod-list">
              <% topProducts.forEach((p, idx) => { %>
                <div class="top-prod-card">
                  <div class="prod-rank-badge <%= idx === 0 ? 'rank-1' : (idx === 1 ? 'rank-2' : (idx === 2 ? 'rank-3' : 'rank-other')) %>">
                    <%= idx + 1 %>
                  </div>
                  <div class="prod-details">
                    <div class="prod-title"><%= p.name %></div>
                    <div class="prod-sub">
                      <span class="sku-badge"><%= p.sku %></span>
                      <span>•</span>
                      <span>Terjual <strong><%= p.total_qty %></strong> pcs</span>
                    </div>
                  </div>
                  <div class="prod-amount-col">
                    <div class="prod-sales-val">
                      Rp <%= new Intl.NumberFormat('id-ID').format(p.total_sales) %>
                    </div>
                    <div class="prod-qty-val">Total Omzet</div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="dash-empty-state">
              <div class="dash-empty-icon">📦</div>
              <p style="font-weight:600;margin:0 0 0.25rem;color:var(--dash-text-main)">Belum ada data produk terlaris</p>
              <span style="font-size:0.8rem">Data akan terisi otomatis seiring transaksi berjalan.</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Low Stock Alerts Panel -->
      <div class="dash-panel">
        <div class="dash-panel-header" style="<%= metrics.lowStockCount > 0 ? 'background:#fff1f2;border-bottom-color:#fecdd3' : '' %>">
          <div class="dash-panel-title">
            <span class="title-icon" style="background:<%= metrics.lowStockCount > 0 ? '#fee2e2' : '#f0fdf4' %>;color:<%= metrics.lowStockCount > 0 ? '#dc2626' : '#16a34a' %>">
              <% if (metrics.lowStockCount > 0) { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
              <% } else { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>
                </svg>
              <% } %>
            </span>
            <div>
              <h2 style="<%= metrics.lowStockCount > 0 ? 'color:#991b1b' : '' %>">
                <%= metrics.lowStockCount > 0 ? 'Peringatan Stok Menipis' : 'Kondisi Stok Gudang' %>
              </h2>
            </div>
          </div>
          <% if (currentUser.role === 'admin') { %>
            <a href="/inventory" style="font-size:0.825rem;color:<%= metrics.lowStockCount > 0 ? '#dc2626' : '#64748b' %>;font-weight:700;text-decoration:none">
              Semua Inventaris →
            </a>
          <% } %>
        </div>
        <div class="dash-panel-body" style="padding:0">
          <% if (lowStockProducts && lowStockProducts.length > 0) { %>
            <div class="table-responsive">
              <table class="recent-sales-table">
                <thead>
                  <tr>
                    <th style="padding-left:1.45rem">Produk & SKU</th>
                    <th style="text-align:center">Sisa</th>
                    <th style="text-align:center">Min</th>
                    <% if (currentUser.role === 'admin') { %>
                      <th style="text-align:center;padding-right:1.45rem">Order</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% lowStockProducts.forEach(lp => { %>
                    <tr>
                      <td style="padding-left:1.45rem">
                        <div style="font-weight:700;color:var(--dash-text-main)"><%= lp.name %></div>
                        <span class="sku-badge"><%= lp.sku %></span>
                      </td>
                      <td style="text-align:center;font-weight:800;color:<%= lp.stock <= 0 ? '#dc2626' : '#d97706' %>">
                        <%= lp.stock %> <%= lp.unit %>
                      </td>
                      <td style="text-align:center;color:var(--dash-text-muted);font-weight:600">
                        <%= lp.min_stock %>
                      </td>
                      <% if (currentUser.role === 'admin') { %>
                        <td style="text-align:center;padding-right:1.45rem">
                          <a href="/purchases/create" class="btn btn-sm btn-primary" style="padding:0.25rem 0.65rem;font-size:0.75rem;font-weight:700;border-radius:6px">
                            + Order
                          </a>
                        </td>
                      <% } %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div style="text-align:center;padding:2rem 1.5rem;color:#16a34a">
              <div style="width:48px;height:48px;border-radius:50%;background:#dcfce7;color:#16a34a;display:inline-flex;align-items:center;justify-content:center;margin-bottom:0.75rem">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <div style="font-weight:800;font-size:0.95rem;color:#15803d">Stok Seluruh Produk Terjaga!</div>
              <p style="margin:0.25rem 0 0;font-size:0.8rem;color:#64748b">Semua produk berada dalam jumlah aman di atas ambang batas minimum.</p>
            </div>
          <% } %>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- Chart.js Engine & Live Clock Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  // 1. Live Real-time Clock in Hero
  function updateLiveClock() {
    const clockEl = document.getElementById('liveClock');
    if (!clockEl) return;
    const now = new Date();
    const hrs = String(now.getHours()).padStart(2, '0');
    const mins = String(now.getMinutes()).padStart(2, '0');
    const secs = String(now.getSeconds()).padStart(2, '0');
    clockEl.textContent = `${hrs}:${mins}:${secs} WIB`;
  }
  updateLiveClock();
  setInterval(updateLiveClock, 1000);

  // 2. High Definition Smooth Chart.js
  const ctx = document.getElementById('salesAnalyticsChart');
  if (!ctx) return;

  const chartLabels = <%- JSON.stringify(chart.labels) %>;
  const chartRevenue = <%- JSON.stringify(chart.revenue) %>;
  const chartTransactions = <%- JSON.stringify(chart.transactions) %>;

  const chartCtx = ctx.getContext('2d');
  
  // Refined vertical gradient for smooth modern SaaS look
  const gradientFill = chartCtx.createLinearGradient(0, 0, 0, 280);
  gradientFill.addColorStop(0, 'rgba(37, 99, 235, 0.28)');
  gradientFill.addColorStop(0.7, 'rgba(37, 99, 235, 0.04)');
  gradientFill.addColorStop(1, 'rgba(37, 99, 235, 0.0)');

  new Chart(ctx, {
    data: {
      labels: chartLabels,
      datasets: [
        {
          type: 'line',
          label: 'Omzet Penjualan (Rp)',
          data: chartRevenue,
          borderColor: '#2563eb',
          borderWidth: 3,
          backgroundColor: gradientFill,
          fill: true,
          tension: 0.4,
          pointRadius: 4,
          pointHoverRadius: 7,
          pointBackgroundColor: '#ffffff',
          pointBorderColor: '#2563eb',
          pointBorderWidth: 2.5,
          yAxisID: 'y',
        },
        {
          type: 'bar',
          label: 'Jumlah Transaksi',
          data: chartTransactions,
          backgroundColor: 'rgba(16, 185, 129, 0.45)',
          hoverBackgroundColor: 'rgba(16, 185, 129, 0.85)',
          borderRadius: 8,
          barPercentage: 0.45,
          yAxisID: 'y1',
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: {
        mode: 'index',
        intersect: false,
      },
      plugins: {
        legend: {
          display: true,
          position: 'top',
          align: 'end',
          labels: {
            boxWidth: 8,
            boxHeight: 8,
            usePointStyle: true,
            pointStyle: 'circle',
            font: { family: 'system-ui', size: 12, weight: '600' },
            color: '#475569'
          }
        },
        tooltip: {
          backgroundColor: '#0f172a',
          titleColor: '#f8fafc',
          bodyColor: '#e2e8f0',
          titleFont: { family: 'system-ui', size: 12, weight: '700' },
          bodyFont: { family: 'system-ui', size: 12 },
          padding: 12,
          cornerRadius: 10,
          boxPadding: 6,
          usePointStyle: true,
          callbacks: {
            label: function(context) {
              if (context.dataset.type === 'line') {
                return ' Omzet: Rp ' + new Intl.NumberFormat('id-ID').format(context.raw);
              } else {
                return ' Transaksi: ' + context.raw + ' struk';
              }
            }
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { font: { family: 'system-ui', size: 11, weight: '600' }, color: '#64748b' }
        },
        y: {
          type: 'linear',
          display: true,
          position: 'left',
          beginAtZero: true,
          grid: { color: '#f1f5f9', borderDash: [4, 4] },
          ticks: {
            font: { family: 'system-ui', size: 11 },
            color: '#64748b',
            callback: function(val) {
              return 'Rp ' + new Intl.NumberFormat('id-ID', { notation: 'compact' }).format(val);
            }
          }
        },
        y1: {
          type: 'linear',
          display: true,
          position: 'right',
          beginAtZero: true,
          grid: { drawOnChartArea: false },
          ticks: {
            stepSize: 1,
            font: { family: 'system-ui', size: 11 },
            color: '#10b981'
          }
        }
      }
    }
  });
});
</script>
