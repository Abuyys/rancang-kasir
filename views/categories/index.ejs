<div class="page-header">
  <h1>📁 Kategori</h1>
  <% if (currentUser.role === 'admin') { %>
    <a href="/categories/create" class="btn btn-primary">+ Tambah Kategori</a>
  <% } %>
</div>

<div class="card" style="margin-bottom: 1.5rem;">
  <div class="card-body">
    <form action="/categories" method="GET" class="filter-form">
      <div class="filter-row">
        <div class="form-group" style="flex: 1; margin-bottom: 0;">
          <input type="text" name="search" placeholder="Cari nama kategori..." 
            value="<%= filters.search || '' %>" class="form-control">
        </div>
        <div class="form-group" style="width: 160px; margin-bottom: 0;">
          <select name="status" class="form-control">
            <option value="">Semua Status</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Aktif</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Cari</button>
        <a href="/categories" class="btn btn-secondary">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (categories.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width:50px">#</th>
            <th>Nama</th>
            <th>Deskripsi</th>
            <th style="width:120px">Jml Produk</th>
            <th style="width:100px">Status</th>
            <% if (currentUser.role === 'admin') { %><th style="width:180px">Aksi</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach((cat, i) => { %>
          <tr>
            <td><%= (pagination.page - 1) * 20 + i + 1 %></td>
            <td><strong><%= cat.name %></strong></td>
            <td><%= cat.description || '-' %></td>
            <td><%= cat.product_count %></td>
            <td>
              <span class="badge <%= cat.is_active ? 'badge-success' : 'badge-danger' %>">
                <%= cat.is_active ? 'Aktif' : 'Nonaktif' %>
              </span>
            </td>
            <% if (currentUser.role === 'admin') { %>
            <td>
              <a href="/categories/<%= cat.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
              <form action="/categories/<%= cat.id %>/toggle-status" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm <%= cat.is_active ? 'btn-danger' : 'btn-success' %>"
                  onclick="return confirm('<%= cat.is_active ? 'Nonaktifkan' : 'Aktifkan' %> kategori ini?')">
                  <%= cat.is_active ? 'Nonaktifkan' : 'Aktifkan' %>
                </button>
              </form>
            </td>
            <% } %>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (pagination.totalPages > 1) { %>
    <div class="pagination">
      <% for (let p = 1; p <= pagination.totalPages; p++) { %>
        <a href="/categories?page=<%= p %>&search=<%= filters.search || '' %>&status=<%= filters.status || '' %>" 
           class="pagination-link <%= p === pagination.page ? 'active' : '' %>"><%= p %></a>
      <% } %>
    </div>
    <% } %>
    <p class="text-muted">Menampilkan <%= categories.length %> dari <%= pagination.total %> kategori</p>
    <% } else { %>
    <p class="text-muted">Belum ada kategori. <% if (currentUser.role === 'admin') { %><a href="/categories/create">Tambah kategori pertama</a><% } %></p>
    <% } %>
  </div>
</div>
