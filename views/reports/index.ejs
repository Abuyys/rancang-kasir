                    <td>
                      <span class="rpt-pill rpt-pill-slate" style="font-weight:700">
                        <%= ebc.category %>
                      </span>
                    </td>
                    <td style="text-align:center;font-weight:600;color:#64748b">
                      <%= ebc.count %>
