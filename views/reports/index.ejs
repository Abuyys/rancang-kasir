    <!-- Card 7: Retur Penjualan -->
    <div class="rpt-kpi-card kpi-accent-rose">
      <div class="rpt-kpi-top">
        <span class="rpt-kpi-title">Retur Pelanggan</span>
        <div class="rpt-kpi-icon" style="background:#fee2e2;color:#dc2626">↩️</div>
      </div>
      <div class="rpt-kpi-val" style="color:#dc2626">
        Rp <%= new Intl.NumberFormat('id-ID').format(summary.totalRefund || 0) %>
      </div>
      <div class="rpt-kpi-sub">
        <span>Pengembalian</span>
        <span class="rpt-pill rpt-pill-rose"><%= summary.returnCount || 0 %> Kasus</span>
      </div>
    </div>
  </div>

  <!-- Split Row 1: Beban Pengeluaran Toko (Kategori & Riwayat Nota) -->
  <div class="rpt-grid-split">
    <!-- Alokasi Beban per Kategori -->
    <div class="rpt-card">
      <div class="rpt-card-header">
        <h2>💸 Alokasi Beban Biaya per Kategori</h2>
        <a href="/expenses" class="btn-rpt btn-rpt-outline" style="font-size:0.725rem;padding:0.25rem 0.55rem">
          Kelola Beban →
