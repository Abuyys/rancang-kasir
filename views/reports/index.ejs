      <div class="rpt-card-header">
        <h2>↩️ Riwayat Pengembalian & Retur Barang</h2>
        <span class="rpt-pill rpt-pill-rose"><%= returns.length %> Pengajuan</span>
      </div>
      <div class="rpt-card-body">
        <div class="rpt-table-responsive">
          <table class="rpt-table">
            <thead>
              <tr>
                <th>No. Retur</th>
                <th>No. Invoice</th>
                <th>Pengaju</th>
                <th>Waktu</th>
                <th>Alasan</th>
                <th style="text-align:right">Refund</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% returns.forEach(r => { %>
                <tr>
                  <td>
                    <span class="rpt-pill rpt-pill-slate" style="font-family:monospace;font-weight:700">
                      <%= r.return_number %>
                    </span>
                  </td>
                  <td>
                    <span style="font-family:monospace;font-weight:600;color:#334155"><%= r.invoice_number %></span>
                  </td>
                  <td><%= r.requester_name || '-' %></td>
                  <td style="white-space:nowrap;color:#64748b;font-size:0.75rem">
                    <%= new Date(r.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                  <td><small style="color:#64748b"><%= r.reason || '-' %></small></td>
                  <td style="text-align:right;font-weight:700;color:#e11d48">
                    Rp <%= new Intl.NumberFormat('id-ID').format(r.total_refund) %>
                  </td>
                  <td>
                    <% if (r.status === 'completed') { %>
                      <span class="rpt-pill rpt-pill-emerald">Selesai</span>
                    <% } else if (r.status === 'requested') { %>
                      <span class="rpt-pill rpt-pill-amber">Diajukan</span>
                    <% } else { %>
                      <span class="rpt-pill rpt-pill-rose">Ditolak</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  // Helper to format Date to YYYY-MM-DD
  function formatDateISO(d) {
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  // Quick Preset Handlers
  function setPreset(type) {
    const today = new Date();
    const startInput = document.getElementById('startDateInput');
    const endInput = document.getElementById('endDateInput');
    const form = document.getElementById('reportDateForm');

    let start = new Date();
    let end = new Date();

    if (type === 'today') {
      start = today;
      end = today;
    } else if (type === '7days') {
      start = new Date(today);
      start.setDate(today.getDate() - 6);
      end = today;
    } else if (type === 'thisMonth') {
      start = new Date(today.getFullYear(), today.getMonth(), 1);
      end = today;
    } else if (type === 'lastMonth') {
      start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
      end = new Date(today.getFullYear(), today.getMonth(), 0);
    } else if (type === 'thisYear') {
      start = new Date(today.getFullYear(), 0, 1);
      end = today;
    }

    startInput.value = formatDateISO(start);
    endInput.value = formatDateISO(end);
    form.submit();
  }

  // Instant Client-Side Search for Products Table
  function filterProductTable() {
    const input = document.getElementById('productSearchInput');
    const filter = input.value.toLowerCase();
    const table = document.getElementById('productTable');
    if (!table) return;

    const tr = table.getElementsByTagName('tr');
    for (let i = 1; i < tr.length; i++) {
      const tdName = tr[i].getElementsByTagName('td')[1];
      const tdSku = tr[i].getElementsByTagName('td')[2];
      if (tdName || tdSku) {
        const textName = tdName ? (tdName.textContent || tdName.innerText) : '';
        const textSku = tdSku ? (tdSku.textContent || tdSku.innerText) : '';
        if (textName.toLowerCase().indexOf(filter) > -1 || textSku.toLowerCase().indexOf(filter) > -1) {
          tr[i].style.display = '';
        } else {
          tr[i].style.display = 'none';
        }
      }
    }
  }
</script>
