                  </td>
                  <td style="text-align:right;font-weight:800;color:#10b981">
                    Rp <%= new Intl.NumberFormat('id-ID').format(p.total_profit) %>
                  </td>
                  <td style="text-align:right">
                    <div class="rpt-bar-track">
                      <div class="rpt-bar-fill" style="width:<%= Math.min(100, Math.max(0, marginPct)) %>%;background:#10b981"></div>
