      <div class="rpt-card-header">
        <h2>📋 Riwayat Pengeluaran Operasional</h2>
        <a href="/reports/export/expenses-csv?start_date=<%= dates.startDate %>&end_date=<%= dates.endDate %>" class="btn-rpt btn-rpt-outline" style="font-size:0.725rem;padding:0.25rem 0.55rem">
          Unduh CSV
        </a>
      </div>
