        <div class="rpt-kpi-icon" style="background:#ecfdf5;color:#10b981">📈</div>
      </div>
      <div class="rpt-kpi-val" style="color:#10b981">
        Rp <%= new Intl.NumberFormat('id-ID').format(summary.grossProfit) %>
      </div>
      <div class="rpt-kpi-sub">
        <span>Margin Barang</span>
        <span class="rpt-pill rpt-pill-emerald">
          <%= summary.adjustedNetSales > 0 ? ((summary.grossProfit / summary.adjustedNetSales) * 100).toFixed(1) : 0 %>%
        </span>
      </div>
    </div>

    <!-- Card 3: Beban Pengeluaran Toko -->
    <div class="rpt-kpi-card kpi-accent-rose">
      <div class="rpt-kpi-top">
        <span class="rpt-kpi-title">Beban Toko</span>
        <div class="rpt-kpi-icon" style="background:#fff1f2;color:#f43f5e">💸</div>
      </div>
      <div class="rpt-kpi-val" style="color:#e11d48">
        Rp <%= new Intl.NumberFormat('id-ID').format(summary.totalExpenses || 0) %>
      </div>
      <div class="rpt-kpi-sub">
        <span>Operasional</span>
        <span class="rpt-pill rpt-pill-rose"><%= summary.expenseCount || 0 %> Nota</span>
      </div>
    </div>

    <!-- Card 4: Estimasi Laba Bersih (Hero Card) -->
    <div class="rpt-kpi-card <%= isProfitable ? 'hero-kpi' : 'hero-kpi-loss' %>">
      <div class="rpt-kpi-top">
        <span class="rpt-kpi-title" style="color:<%= isProfitable ? '#15803d' : '#be123c' %>">
          Laba Bersih
        </span>
        <div class="rpt-kpi-icon" style="background:<%= isProfitable ? '#dcfce7' : '#fee2e2' %>">
          <%= isProfitable ? '💎' : '⚠️' %>
        </div>
      </div>
      <div class="rpt-kpi-val" style="color:<%= isProfitable ? '#15803d' : '#e11d48' %>">
        Rp <%= new Intl.NumberFormat('id-ID').format(summary.netProfit || 0) %>
      </div>
      <div class="rpt-kpi-sub">
        <span style="font-weight:700">Kotor − Beban</span>
        <span class="rpt-pill <%= isProfitable ? 'rpt-pill-emerald' : 'rpt-pill-rose' %>">
          <%= isProfitable ? 'Surplus' : 'Defisit' %>
        </span>
      </div>
    </div>

    <!-- Card 5: Transaksi Kasir -->
    <div class="rpt-kpi-card kpi-accent-slate">
      <div class="rpt-kpi-top">
        <span class="rpt-kpi-title">Total Transaksi</span>
        <div class="rpt-kpi-icon" style="background:#f1f5f9;color:#475569">🧾</div>
      </div>
      <div class="rpt-kpi-val" style="color:var(--text-main)">
        <%= summary.transactionCount %>
      </div>
      <div class="rpt-kpi-sub">
        <span>Rata-rata Trx</span>
        <span style="font-weight:700;color:var(--text-main)">
          Rp <%= new Intl.NumberFormat('id-ID').format(Math.round(summary.avgTransactionValue || 0)) %>
        </span>
      </div>
    </div>

    <!-- Card 6: Pembelian Supplier -->
    <div class="rpt-kpi-card kpi-accent-amber">
      <div class="rpt-kpi-top">
        <span class="rpt-kpi-title">Faktur Masuk</span>
        <div class="rpt-kpi-icon" style="background:#fffbeb;color:#f59e0b">🚚</div>
      </div>
      <div class="rpt-kpi-val" style="color:#d97706">
        Rp <%= new Intl.NumberFormat('id-ID').format(summary.totalPurchases || 0) %>
      </div>
      <div class="rpt-kpi-sub">
        <span>Restock Gudang</span>
