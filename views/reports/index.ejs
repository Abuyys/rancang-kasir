  <!-- Split Row 2: Kinerja Kasir & Pembelian Supplier -->
  <div class="rpt-grid-split">
    <!-- Kinerja Kasir -->
    <div class="rpt-card">
      <div class="rpt-card-header">
        <h2>👤 Kinerja Penjualan per Kasir</h2>
