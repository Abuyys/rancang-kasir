      </div>
      <div class="rpt-card-body">
        <% if (typeof expensesByCategory !== 'undefined' && expensesByCategory && expensesByCategory.length > 0) { %>
          <% const totalBeban = (summary.totalExpenses > 0 ? summary.totalExpenses : 1); %>
