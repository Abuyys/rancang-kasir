                <th>SKU</th>
                <th style="text-align:center">Terjual</th>
                <th style="text-align:right">Total Omzet</th>
                <th style="text-align:right">Laba Kotor</th>
                <th style="text-align:right">Margin (%)</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach((p, idx) => { %>
                <% const marginPct = p.total_revenue > 0 ? ((p.total_profit / p.total_revenue) * 100).toFixed(1) : '0'; %>
                <tr>
                  <td style="text-align:center">
                    <span class="rpt-rank-badge <%= idx === 0 ? 'rank-1' : (idx === 1 ? 'rank-2' : (idx === 2 ? 'rank-3' : 'rank-normal')) %>">
                      <%= idx + 1 %>
                    </span>
                  </td>
                  <td>
                    <strong style="color:var(--text-main)"><%= p.name %></strong>
                  </td>
                  <td>
                    <code style="background:#f1f5f9;padding:0.15rem 0.35rem;border-radius:4px;font-size:0.75rem;color:#475569">
