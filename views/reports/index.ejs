  <!-- Full Width: Kinerja Produk & Margin Laba Kotor (Top 20) -->
  <div class="rpt-card">
    <div class="rpt-card-header">
      <div style="display:flex;align-items:center;gap:0.6rem">
        <h2>🏆 Kinerja Produk & Estimasi Laba Kotor (Top 20)</h2>
