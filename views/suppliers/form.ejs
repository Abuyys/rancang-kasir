<div class="page-header">
  <h1><%= supplier ? '✏️ Edit Supplier' : '➕ Tambah Supplier' %></h1>
  <a href="/suppliers" class="btn btn-secondary">← Kembali</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="<%= supplier ? '/suppliers/' + supplier.id : '/suppliers' %>" method="POST" style="max-width:600px">
      <div class="form-group">
        <label for="name">Nama Supplier <span style="color:red">*</span></label>
        <input type="text" id="name" name="name" class="form-control" required value="<%= supplier ? supplier.name : '' %>">
      </div>
      <div class="form-row">
        <div class="form-group" style="flex:1">
          <label for="phone">Telepon</label>
          <input type="text" id="phone" name="phone" class="form-control" value="<%= supplier ? (supplier.phone || '') : '' %>">
        </div>
        <div class="form-group" style="flex:1">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" value="<%= supplier ? (supplier.email || '') : '' %>">
        </div>
      </div>
      <div class="form-group">
        <label for="address">Alamat</label>
        <textarea id="address" name="address" class="form-control" rows="2"><%= supplier ? (supplier.address || '') : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="notes">Catatan</label>
        <textarea id="notes" name="notes" class="form-control" rows="2"><%= supplier ? (supplier.notes || '') : '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= supplier ? 'Simpan Perubahan' : 'Tambah Supplier' %></button>
        <a href="/suppliers" class="btn btn-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>
