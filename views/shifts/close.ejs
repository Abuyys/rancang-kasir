<div class="page-header">
  <h1>⏹ Tutup Shift</h1>
  <a href="/shifts" class="btn btn-secondary">← Kembali</a>
</div>

<div class="detail-grid">
  <div class="card">
    <div class="card-header"><h2>Ringkasan Shift</h2></div>
    <div class="card-body">
      <table class="detail-table">
        <tr><th>Kasir</th><td><%= shift.user_name %></td></tr>
        <tr><th>Dibuka</th><td><%= shift.opened_at %></td></tr>
        <tr><th>Modal Awal</th><td>Rp <%= new Intl.NumberFormat('id-ID').format(shift.opening_cash) %></td></tr>
        <tr><th>Total Penjualan</th><td>Rp <%= new Intl.NumberFormat('id-ID').format(summary.totalSales) %></td></tr>
        <tr><th>Jumlah Transaksi</th><td><%= summary.transactionCount %></td></tr>
        <tr><th>Penjualan Tunai</th><td>Rp <%= new Intl.NumberFormat('id-ID').format(summary.totalCash) %></td></tr>
        <tr style="font-weight:bold;font-size:1.1rem"><th>Kas Diharapkan</th><td>Rp <%= new Intl.NumberFormat('id-ID').format(closingCashExpected) %></td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Tutup Shift</h2></div>
    <div class="card-body">
      <form action="/shifts/<%= shift.id %>/close" method="POST">
        <div class="form-group">
          <label for="closing_cash_actual">Uang Kas Aktual (Rp) <span style="color:red">*</span></label>
          <input type="number" id="closing_cash_actual" name="closing_cash_actual" class="form-control" min="0" step="1" required autofocus>
          <small class="text-muted">Hitung uang tunai fisik di laci kas.</small>
        </div>
        <div class="form-group">
          <label for="notes">Catatan</label>
          <textarea id="notes" name="notes" class="form-control" rows="2" placeholder="Catatan opsional"></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Yakin tutup shift?')">Tutup Shift</button>
          <a href="/shifts" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>
