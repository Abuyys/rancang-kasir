<div class="page-header">
  <h1>▶ Buka Shift</h1>
  <a href="/shifts" class="btn btn-secondary">← Kembali</a>
</div>
<div class="card">
  <div class="card-body">
    <form action="/shifts/open" method="POST" style="max-width:400px">
      <div class="form-group">
        <label for="opening_cash">Uang Modal Awal (Rp) <span style="color:red">*</span></label>
        <input type="number" id="opening_cash" name="opening_cash" class="form-control" min="0" step="1" required placeholder="Contoh: 200000" autofocus>
        <small class="text-muted">Masukkan jumlah uang tunai di laci kas saat ini.</small>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Buka Shift Sekarang</button>
        <a href="/shifts" class="btn btn-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>
